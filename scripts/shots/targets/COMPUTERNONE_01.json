      "waitFor": "[data-testid='computer-provision']",
      "note": "A host can run one: the button is there."
    },
    {
      "id": "COMPUTERNONE_01-checking",
      "route": "/m/COMPUTERNONE_01?part=checking",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-checking']",
      "note": "While the Space is asked where a computer can run, no button."
    },
    {
      "id": "COMPUTERNONE_01-runner",
      "route": "/m/COMPUTERNONE_01?part=runner",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-cannot']",
      "note": "The server's container runner is not running: the reason and the next step, no button."
    },
    {
      "id": "COMPUTERNONE_01-mac",
      "route": "/m/COMPUTERNONE_01?part=mac",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-cannot']",
      "note": "On a Mac with Docker stopped: start Docker Desktop or Colima."
    },
    {
      "id": "COMPUTERNONE_01-space",
      "route": "/m/COMPUTERNONE_01?part=space",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-cannot']",
      "note": "No machine can run one yet: add a server with Docker."
    },
    {
      "id": "COMPUTERNONE_01-member",
      "route": "/m/COMPUTERNONE_01?part=member",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-provision-admin']",
      "note": "A member is told who sets it up."
    },
    {
      "id": "COMPUTERNONE_01-error",
      "route": "/m/COMPUTERNONE_01?part=error",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-cannot']",
      "note": "The Space did not answer: the reason, no button."
    },
    {
      "id": "COMPUTERNONE_01-picks",
      "route": "/m/COMPUTERNONE_01?part=picks",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-provision']",
      "note": "Two machines: the one with the most room is preselected, each shows its room."
    },
    {
      "id": "COMPUTERNONE_01-setup1",
      "route": "/m/COMPUTERNONE_01?part=setup1",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-setting-up']",
      "note": "Setting up: step 1 of 4, with where it runs."
    },
    {
      "id": "COMPUTERNONE_01-setup3",
      "route": "/m/COMPUTERNONE_01?part=setup3",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-setting-up']",
      "note": "Setting up: installing Chrome."
    },
    {
      "id": "COMPUTERNONE_01-failed",
      "route": "/m/COMPUTERNONE_01?part=failed",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-failed']",
      "note": "Failed: the real reason, Copy details, Try again."
    },
    {
      "id": "COMPUTERNONE_01-ready",
      "route": "/m/COMPUTERNONE_01?part=ready",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-chip']",
      "note": "Ready: the whole pane on Computer: the picture is the open, one state chip, one footer line; no Open or Sleep button."
    },
    {
      "id": "COMPUTERNONE_01-nocomputer",
      "route": "/m/COMPUTERNONE_01?part=nocomputer",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='about-no-computer']",
      "note": "An agent without a computer: About with one quiet row and the offer; no Computer or Terminal tab."
    },
    {
      "id": "COMPUTERNONE_01-asleep",
      "route": "/m/COMPUTERNONE_01?part=asleep",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='computer-chip']",
      "note": "Asleep: dimmed picture, chip says it wakes when needed."
    },
    {
      "id": "COMPUTERNONE_01-about",
      "route": "/m/COMPUTERNONE_01?part=about",
      "proto": "chats,{skin}",
      "waitFor": "[data-testid='about-tab']",
      "note": "About of an agent with a computer: responsible for, right now, how it responds here, shared context."
    }

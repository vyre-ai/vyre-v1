    },
    {
      "id": "CHROME2A_01-gate-dropped",
      "route": "/m/CHROME2A_01?part=gate-dropped",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid^='approval-']",
      "note": "After Don't send: Not sent."
    },
    {
      "id": "CHROME2A_01-gate-edited",
      "route": "/m/CHROME2A_01?part=gate-edited",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid^='approval-']",
      "note": "After a Save the card stays held and says Edited by you."

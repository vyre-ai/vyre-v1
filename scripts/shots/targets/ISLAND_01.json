{
  "targets": [
    {
      "id": "ISLAND_01-working",
      "route": "/m/ISLAND_01?view=working",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid='island-pill']",
      "note": "An agent is writing: the Working pill."
    },
    {
      "id": "ISLAND_01-card",
      "route": "/m/ISLAND_01?view=question",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid='blk-question-blk_q1']",
      "walk": "card",
      "note": "Question card in view: the pill is Working, the question is answered on its card."
    },
    {
      "id": "ISLAND_01-question",
      "route": "/m/ISLAND_01?view=question",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid='blk-question-blk_q1']",
      "walk": "away",
      "after": "[data-testid='island-question']",
      "note": "Card scrolled out of view: the pill is the question, the recommended choice and Other."
    },
    {
      "id": "ISLAND_01-back",
      "route": "/m/ISLAND_01?view=question",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid='blk-question-blk_q1']",
      "walk": "back",
      "note": "Scrolled away then back to the card: the pill steps aside to Working."
    },
    {
      "id": "ISLAND_01-several",
      "route": "/m/ISLAND_01?view=several",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid='blk-question-blk_q1']",
      "walk": "away",
      "after": "[data-testid='island-count']",
      "note": "Three questions, card out of view: 1 of 3 with arrows."
    },
    {
      "id": "ISLAND_01-other",
      "route": "/m/ISLAND_01?view=question",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid='blk-question-blk_q1']",
      "walk": "away",
      "after": "[data-testid='island-other']",
      "click": "[data-testid='island-other']",
      "after2": "[data-testid='island-other-field']",
      "note": "Other open: a short text field and Send."
    },
    {
      "id": "ISLAND_01-answered",
      "route": "/m/ISLAND_01?view=question",
      "proto": "chat,{skin}",
      "waitFor": "[data-testid='blk-question-blk_q1']",
      "walk": "away",
      "after": "[data-testid='island-choice-2gb']",
      "click": "[data-testid='island-choice-2gb']",
      "after2": "[data-testid='island-pill']",
      "note": "After pressing 2 GB: the pill goes back to Working."
    }
  ]
}

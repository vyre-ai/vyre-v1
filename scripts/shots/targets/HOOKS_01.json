{
  "targets": [
    {
      "id": "HOOKS_01-lines",
      "route": "/m/HOOKS_01?view=lines",
      "proto": "chat,at:crew;t=55;hooks=hchat,{skin}",
      "waitFor": "[data-testid^='event-']",
      "note": "The quiet lines a hook leaves in the chat: added a hook, set a hook for helpers, and A hook stopped this with Details."
    },
    {
      "id": "HOOKS_01-tab",
      "route": "/m/HOOKS_01?view=tab",
      "proto": "chat,at:crew;t=55;hooks=hchat,{skin}",
      "waitFor": "[data-testid='hooks-list']",
      "note": "The Hooks tab in the shared side pane, grouped by scope, with Pause, Edit and Remove; a Space hook says only an admin can remove it."
    },
    {
      "id": "HOOKS_01-helper",
      "route": "/m/HOOKS_01?view=helper",
      "proto": "chat,at:crew;t=55;hooks=hchat,{skin}",
      "waitFor": "[data-testid='helper-hooks']",
      "note": "A helper's page with its hooks: the ones its lead gave it, and the Inherited ones."
    },
    {
      "id": "HOOKS_01-tab-edit",
      "route": "/m/HOOKS_01?view=tab",
      "waitFor": "[data-testid='hooks-list']",
      "steps": [
        [
          "click",
          "[data-testid='hook-edit-hok_chat']"
        ]
      ],
      "after": "[data-testid='hook-form-hok_chat']",
      "note": "The Edit form open on a hook: When, What it does (Run a script, Ask a quick check, Do an action), Save and Cancel.",
      "proto": "chat,at:crew;t=55;hooks=hchat,{skin}"
    },
    {
      "id": "HOOKS_01-tab-undo",
      "route": "/m/HOOKS_01?view=tab",
      "waitFor": "[data-testid='hooks-list']",
      "steps": [
        [
          "click",
          "[data-testid='hook-remove-hok_agent']"
        ]
      ],
      "after": "[data-testid='pane-notice']",
      "note": "After Remove: the hook is gone and the notice at the foot says Hook removed, with Undo.",
      "proto": "chat,at:crew;t=55;hooks=hchat,{skin}"
    },
    {
      "id": "HOOKS_01-tab-when",
      "route": "/m/HOOKS_01?view=tab",
      "waitFor": "[data-testid='hooks-list']",
      "steps": [
        [
          "click",
          "[data-testid='hook-edit-hok_chat']"
        ],
        [
          "click",
          "[data-testid='hook-event-hok_chat']"
        ]
      ],
      "after": "[data-testid='hook-form-hok_chat']",
      "note": "The When picker open: a quiet menu of plain choices, never pills.",
      "proto": "chat,at:crew;t=55;hooks=hchat,{skin}"
    },
    {
      "id": "HOOKS_01-helper-hover",
      "route": "/m/HOOKS_01?view=helper",
      "waitFor": "[data-testid='helper-hooks']",
      "steps": [
        [
          "hover",
          "[data-testid='helper-hook-hok_run']"
        ]
      ],
      "note": "A helper's hook row under the pointer: a hairline tint and a chevron, since the row opens the Hooks tab.",
      "proto": "chat,at:crew;t=55;hooks=hchat,{skin}"
    },
    {
      "id": "HOOKS_01-answered",
      "route": "/m/HOOKS_01?view=answered",
      "waitFor": "[data-testid^='hook-said-']",
      "note": "A stop that was answered: it reads Denied. The stop stands. with Details, for everyone, and no verbs left.",
      "proto": "chat,at:crew;t=55;hooks=hchat,{skin}"
    }
  ]
}
    {
      "id": "CONSOLIDATE_01-device",
      "route": "/m/CONSOLIDATE_01?part=device",
      "proto": "overview,{skin}",
      "waitFor": "[data-testid='machines']",
      "note": "Settings, This device: my own machines in the same component, then Phone access."
    },
    {
      "id": "CONSOLIDATE_01-device-machine",
      "route": "/m/CONSOLIDATE_01?part=device-machine",
      "proto": "overview,{skin}",
      "waitFor": "[data-testid='machine-charts']",
      "note": "My own MacBook in full: load, running turns, limits."
    },
    {
      "id": "CONSOLIDATE_01-you",
      "route": "/m/CONSOLIDATE_01?part=you",
      "proto": "overview,{skin}",
      "waitFor": "[data-testid='settings-place']",
      "note": "Settings, You: the profile with About you and memory under it."
    }

{
  "_comment": "Second layer under the sandbox (prompt rule and stripped env are the others). Prefix matches only, so the sandbox is the real boundary. kernel/, packages/contracts/src and manifest paths are protected by the owns_files check, not by deny rules: a worker may read them but any edit outside its lane's globs rejects the run.",
  "deny": [
    "Bash(node:*)",
    "Bash(npm:*)",
    "Bash(npx:*)",
    "Bash(pnpm:*)",
    "Bash(yarn:*)",
    "Bash(corepack:*)",
    "Bash(git push:*)",
    "Bash(gh:*)",
    "Bash(git reset:*)",
    "Bash(git rebase:*)",
    "Bash(git stash:*)",
    "Bash(git checkout main:*)",
    "Bash(git branch -D:*)",
    "Bash(git clean:*)",
    "Bash(rm -rf /:*)",
    "Bash(rm -rf ~:*)",
    "Bash(rm -rf ..:*)",
    "Bash(rm -rf $HOME:*)",
    "Bash(rm -rf /Users:*)",
    "Bash(sudo:*)",
    "Bash(curl:*)",
    "Bash(wget:*)",
    "Bash(ssh:*)",
    "Bash(scp:*)",
    "Bash(nc:*)",
    "Bash(gh api:*)",
    "Bash(gh auth:*)",
    "Bash(gh secret:*)",
    "Bash(gh repo delete:*)",
    "Bash(gh pr merge:*)",
    "Bash(cat ~/Claude/simba:*)",
    "Bash(cat /Users/irfad/Claude/simba:*)",
    "Bash(ls /Users/irfad/Claude/simba:*)",
    "Bash(source:*)",
    "Bash(env:*)",
    "Bash(printenv:*)",
    "Read(/Users/irfad/Claude/simba/**)",
    "Read(~/Claude/simba/**)",
    "Read(~/.ssh/**)",
    "Read(~/.grok/auth*)",
    "Edit(/Users/irfad/Claude/simba/**)",
    "Write(/Users/irfad/Claude/simba/**)"
  ],
  "secret_paths": [
    "~/Claude/simba/secrets",
    "~/.ssh",
    "~/.config/gh",
    "~/.cloudflared",
    "~/Library/Keychains",
    "~/.aws",
    "~/.gnupg",
    "~/.netrc",
    "~/.config/git"
  ],
  "env_strip": "(TOKEN|SECRET|KEY|PASSWORD|DATABASE_URL)",
  "env_keep": [
    "GROK_API_KEY"
  ]
}

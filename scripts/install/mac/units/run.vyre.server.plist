<?xml version="1.0" encoding="UTF-8"?>
<!-- @MARK@ -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>run.vyre.server</string>
  <key>UserName</key><string>@USER@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BIN@</string>
    <string>start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>VYRE_DIR</key><string>@VYRE_DIR@</string>
    <key>PATH</key><string>@VYRE_DIR@/tools/bin:@VYRE_DIR@/tools/lima/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- one-shot at boot: waits for the container runtime, brings the containers up, and exits; tried again every 30 s while it fails -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@VYRE_DIR@/logs/server.log</string>
  <key>StandardErrorPath</key><string>@VYRE_DIR@/logs/server.log</string>
</dict>
</plist>

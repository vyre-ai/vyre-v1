#!/bin/sh
# vyre-server: run and look after Vyre Server on this machine. install.sh puts it in /usr/local/bin; each release carries its own copy
# and the command always runs the current release's. Spec 3.13, ARCH 7.13.
#
#   vyre-server doctor [--json] [--quiet]   check this machine and the server; works with the server down. Exit 1 when anything is down.
#   vyre-server status                      the containers and their health
#   vyre-server start | stop | restart      what the systemd unit runs
#   vyre-server logs [SERVICE] [--no-follow]  follow the logs (vyred, caddy); Ctrl-C stops; --no-follow prints the last lines and exits
#   vyre-server claim-link                  print the one-time link that claims a fresh Space as its owner (valid 24 hours; each start makes a new one)
#   vyre-server update [--check] [--yes]    read the channel's signed manifest; if it names a newer version: back up the data (server running), then stop, switch, check health, roll back on failure; --stopped-backup stops first
#   vyre-server rollback                    switch back to the previous release (code only; data written by the newer one stays)
#   vyre-server backup                      write a backup of the data directory to the backup folder, by default next to the data (the server keeps running)
#   vyre-server restore FILE [--yes]        put a backup back: checks it, backs up the current data, stops, restores, starts, checks health
#   vyre-server fix-userns                  let the engine sandbox make user namespaces (Ubuntu 24.04 setting); install and update do this themselves
#   vyre-server version
#
# Environment: VYRE_DIR (found from this script when unset).

set -eu

# real_path PATH: PATH with every link resolved. readlink -f where it works; macOS before 12.3 has no -f, so links are followed one by one there.
real_path() {
  readlink -f "$1" 2>/dev/null && return 0
  _rp=$1; _rn=0
  while [ -L "$_rp" ] && [ "$_rn" -lt 40 ]; do
    _rl=$(readlink "$_rp") || break
    case "$_rl" in /*) _rp=$_rl ;; *) _rp=$(dirname "$_rp")/$_rl ;; esac
    _rn=$((_rn + 1))
  done
  _rd=$(cd -P "$(dirname "$_rp")" 2>/dev/null && pwd -P) || { printf '%s\n' "$1"; return 0; }
  printf '%s/%s\n' "$_rd" "$(basename "$_rp")"
}

# Where the install lives: VYRE_DIR, else four levels above this file (DIR/releases/<version>/bin/vyre-server), else /srv/vyre.
find_dir() {
  if [ -n "${VYRE_DIR:-}" ]; then printf '%s' "$VYRE_DIR"; return 0; fi
  self=$(real_path "$0")
  cand=$(dirname "$(dirname "$(dirname "$(dirname "$self")")")")
  if [ -f "$cand/compose.env" ]; then printf '%s' "$cand"; else printf '/srv/vyre'; fi
}
DIR=$(find_dir)
DRY=0
YES=0
STOPPED_BACKUP=0
TMP=""
LOCKDIR=""
STAGE=""
RSTAGE=""
WANT=""
WANT_SHA256=""
CHANNEL=$(cat "$DIR/channel" 2>/dev/null || printf stable)
UPDATE_URL=${VYRE_UPDATE_URL:-$(cat "$DIR/update-url" 2>/dev/null || printf 'https://github.com/vyre-ai/vyre-v1/releases/latest/download/')}
DATA_DIR=$(cat "$DIR/data-dir" 2>/dev/null || printf '%s/data' "$DIR")
# where backups are written: with the data (so a data folder on an encrypted volume holds its backups too); an install made before this was recorded keeps $VYRE_DIR/backups
BACKUP_DIR=$(cat "$DIR/backup-dir" 2>/dev/null || printf '%s/backups' "$DIR")
UNIT_DIR=${VYRE_SYSTEMD_DIR:-/etc/systemd/system}
KEEP_BACKUPS=3
KEEP_RELEASES=3

say() { printf '%s\n' "$*"; }
die() { printf 'vyre-server: %s\n' "$*" >&2; exit "${2:-1}"; }
cleanup() { [ -z "$TMP" ] || rm -rf "$TMP"; [ -z "${STAGE:-}" ] || rm -rf "$STAGE"; [ -z "${RSTAGE:-}" ] || rm -rf "$RSTAGE"; [ -z "${LOCKDIR:-}" ] || rm -f "$LOCKDIR/pid"; rmdir "$LOCKDIR" 2>/dev/null || true; return 0; }

# BEGIN diskcheck
# disk_encrypted DIR: 0 when the volume that holds DIR is encrypted, 1 when it is not, 2 when it cannot be told.
# Linux: the mount that holds DIR (longest target in /proc/mounts) is ecryptfs, an encrypted ZFS dataset, or its block device stack has a
# dm-crypt layer (`lsblk -s` lists a "crypt" row). Anything else, including tmpfs and overlay, is not encrypted.
# macOS: `diskutil info` for the volume that holds DIR says FileVault: Yes (or Encrypted: Yes for an external volume).
disk_encrypted() {
  _d=$1
  _os=$(uname -s)
  [ "${VYRE_TEST_MODE:-0}" != 1 ] || [ -z "${VYRE_TEST_OS:-}" ] || _os=$VYRE_TEST_OS
  if [ "$_os" = Darwin ]; then
    _du=diskutil
    [ "${VYRE_TEST_MODE:-0}" != 1 ] || [ -z "${VYRE_TEST_DISKUTIL:-}" ] || _du=$VYRE_TEST_DISKUTIL
    _dev=$(df -P "$_d" 2>/dev/null | awk 'NR==2 {print $1}')
    [ -n "$_dev" ] || return 2
    _info=$("$_du" info "$_dev" 2>/dev/null || true)
    if printf '%s\n' "$_info" | grep -Eq '^ *(FileVault|Encrypted): +Yes'; then return 0; fi
    if printf '%s\n' "$_info" | grep -Eq '^ *(FileVault|Encrypted): +No'; then return 1; fi
    return 2
  fi
  _mounts=/proc/mounts
  _lsblk=lsblk
  if [ "${VYRE_TEST_MODE:-0}" = 1 ]; then _mounts=${VYRE_TEST_PROC_MOUNTS:-/proc/mounts}; [ -z "${VYRE_TEST_LSBLK:-}" ] || _lsblk=$VYRE_TEST_LSBLK; fi
  [ -r "$_mounts" ] || return 2
  _d=$(printf '%s' "$_d" | sed 's|/*$||'); [ -n "$_d" ] || _d=/
  _row=$(awk -v d="$_d" '
    { t = $2; gsub(/\\040/, " ", t) }
    (t == "/" || d == t || index(d, t "/") == 1) && length(t) >= best { best = length(t); line = $1 " " $3 }
    END { print line }' "$_mounts")
  [ -n "$_row" ] || return 2
  _src=${_row% *}
  _fs=${_row#* }
  case "$_fs" in
    ecryptfs) return 0 ;;
    zfs)
      _enc=$(zfs get -H -o value encryption "$_src" 2>/dev/null || true)
      case "$_enc" in ""|off|-) return 1 ;; *) return 0 ;; esac ;;
    tmpfs|overlay|ramfs|nfs|nfs4|cifs|9p|fuse*) return 1 ;;
  esac
  case "$_src" in /dev/*) ;; *) return 1 ;; esac
  _types=$("$_lsblk" -s -n -o TYPE "$_src" 2>/dev/null || true)
  [ -n "$_types" ] || return 2
  case "
$_types
" in *"
crypt
"*) return 0 ;; esac
  return 1
}
# END diskcheck

# BEGIN semver
# ver_cmp A B: prints -1, 0 or 1 (semver order: a prerelease sorts before its release; beta.10 is after beta.9). Returns 2 on a string that is not a version.
ver_cmp() {
  awk -v a="$1" -v b="$2" '
    function parse(v, o,   m, core, pre, n, i, parts) {
      if (v !~ /^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?$/) return 0
      core = v; pre = ""
      if (index(v, "-")) { core = substr(v, 1, index(v, "-") - 1); pre = substr(v, index(v, "-") + 1) }
      split(core, parts, ".")
      o["maj"] = parts[1] + 0; o["min"] = parts[2] + 0; o["pat"] = parts[3] + 0; o["pre"] = pre
      return 1
    }
    function cmpnum(x, y) { return x < y ? -1 : (x > y ? 1 : 0) }
    function cmppre(p, q,   pp, qq, np, nq, i, x, y, isx, isy, c) {
      if (p == q) return 0
      if (p == "") return 1
      if (q == "") return -1
      np = split(p, pp, "."); nq = split(q, qq, ".")
      for (i = 1; i <= np && i <= nq; i++) {
        x = pp[i]; y = qq[i]; isx = (x ~ /^[0-9]+$/); isy = (y ~ /^[0-9]+$/)
        if (isx && isy) { c = cmpnum(x + 0, y + 0); if (c) return c }
        else if (isx) return -1
        else if (isy) return 1
        else if (x != y) return x < y ? -1 : 1
      }
      return cmpnum(np, nq)
    }
    BEGIN {
      if (!parse(a, A) || !parse(b, B)) exit 2
      c = cmpnum(A["maj"], B["maj"]); if (!c) c = cmpnum(A["min"], B["min"]); if (!c) c = cmpnum(A["pat"], B["pat"]); if (!c) c = cmppre(A["pre"], B["pre"])
      print c
    }'
}
# END semver

# BEGIN release
# The Vyre release public key (Ed25519). The private half lives only in the `release` GitHub Environment. VYRE_RELEASE_KEY_PEM (a file) is for tests.
RELEASE_KEY_PEM='-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAoh2/Z+k+ZXGNRVKYlkVeE6TLKWt3+HK3rxm6gbCU6Po=
-----END PUBLIC KEY-----'

# ---- the signed release -------------------------------------------------------------------------------------------------------------
release_key_file() {
  if [ "${VYRE_TEST_MODE:-0}" = 1 ] && [ -n "${VYRE_RELEASE_KEY_PEM:-}" ]; then printf '%s' "$VYRE_RELEASE_KEY_PEM"; return 0; fi
  printf '%s\n' "$RELEASE_KEY_PEM" >"$TMP/release-key.pem"
  printf '%s' "$TMP/release-key.pem"
}

# verify_manifest MANIFEST SIG_B64FILE: Ed25519 over "vyre-release-sums\n" followed by the exact manifest bytes.
verify_manifest() {
  key=$(release_key_file)
  tr -d ' \n\r' <"$2" | openssl base64 -d -A >"$TMP/sig.bin" 2>/dev/null || return 1
  [ "$(wc -c <"$TMP/sig.bin" | tr -d ' ')" = 64 ] || return 1
  { printf 'vyre-release-sums\n'; cat "$1"; } >"$TMP/signed.msg"
  "${OSSL:-openssl}" pkeyutl -verify -pubin -inkey "$key" -rawin -in "$TMP/signed.msg" -sigfile "$TMP/sig.bin" >/dev/null 2>&1
}

# sha256_of FILE: the hex digest (sha256sum on Linux, shasum on macOS).
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi
}

fetch() { curl -fsSL --retry 3 --retry-delay 2 --max-time "${3:-120}" "$1" -o "$2"; }

# fetch_release: the channel's manifest and the release tarball, both checked. Sets REL_VERSION and REL_TARBALL (a checked file).
fetch_release() {
  base=${UPDATE_URL%/}
  say "  Fetching the $CHANNEL release manifest from $base/"
  fetch "$base/$CHANNEL.json" "$TMP/manifest.json" 30 || die "could not reach $base/$CHANNEL.json; check this machine's network and run the installer again."
  fetch "$base/$CHANNEL.json.sig" "$TMP/manifest.sig" 30 || die "could not fetch the manifest's signature; nothing was installed."
  verify_manifest "$TMP/manifest.json" "$TMP/manifest.sig" || die "the release signature does not match the Vyre release key in this installer; nothing was installed."
  say "  ok  the release signature verifies"
  [ "$(jq -r '.v // empty' "$TMP/manifest.json")" = 1 ] || die "the release manifest is not a version this installer reads; nothing was installed."
  [ "$(jq -r '.channel // empty' "$TMP/manifest.json")" = "$CHANNEL" ] || die "the manifest is for another channel than $CHANNEL; nothing was installed."
  REL_VERSION=$(jq -r '.server.version // empty' "$TMP/manifest.json")
  url=$(jq -r '.server.tarball // empty' "$TMP/manifest.json")
  sum=$(jq -r '.server.sha256 // empty' "$TMP/manifest.json")
  ver_cmp "$REL_VERSION" "$REL_VERSION" >/dev/null 2>&1 || die "the manifest has no server version; nothing was installed."
  case "$sum" in *[!0-9a-f]*|"") die "the manifest does not give the artifact's sha256; nothing was installed." ;; esac
  [ "${#sum}" = 64 ] || die "the manifest does not give the artifact's sha256; nothing was installed."
  if [ -n "$WANT" ] && [ "$WANT" != latest ] && [ "$WANT" != "$REL_VERSION" ]; then
    die "the $CHANNEL channel offers $REL_VERSION, not $WANT; nothing was installed."
  fi
  if [ -n "${WANT_SHA256:-}" ] && [ "$WANT_SHA256" != "$sum" ]; then
    die "the reviewed artifact changed on the $CHANNEL channel; check the release again before installing. Nothing was installed."
  fi
  case "$url" in http://*|https://*) ;; "") die "the manifest names no artifact; nothing was installed." ;; *) url="$base/$url" ;; esac
  say "  Downloading Vyre Server $REL_VERSION"
  fetch "$url" "$TMP/release.tgz" 900 || die "could not download $url; nothing was installed."
  got=$(sha256_of "$TMP/release.tgz")
  [ "$got" = "$sum" ] || die "the download does not match the signed release (wanted $sum, got $got); nothing was installed."
  say "  ok  the download matches the signed release"
  REL_TARBALL=$TMP/release.tgz
}

# unpack_release: into $DIR/releases/<version>, refusing any path that would leave it and any release without the files the server needs.
unpack_release() {
  rel=$DIR/releases/$REL_VERSION
  if [ -d "$rel" ] && [ -f "$rel/.complete" ]; then say "  Release $REL_VERSION is already unpacked"; return 0; fi
  if [ "$DRY" = 1 ]; then say "would unpack $REL_VERSION to $rel"; return 0; fi
  tar -tzf "$REL_TARBALL" | awk '{ if ($0 ~ /^\// || $0 ~ /(^|\/)\.\.(\/|$)/) bad = 1 } END { exit bad }' || die "the release holds a path outside its folder; nothing was installed."
  tar -tvzf "$REL_TARBALL" | awk '$1 ~ /^[lh]/ { bad = 1 } END { exit bad }' || die "the release holds a link; nothing was installed."
  rm -rf "$rel.part"
  mkdir -p "$rel.part"
  tar -xzf "$REL_TARBALL" -C "$rel.part" --strip-components=1 --no-same-owner
  for f in VERSION compose.server.yml Caddyfile images.lock bin/vyre-server units/vyre-server.service units/vyre-server-update.service units/vyre-server-update.timer; do
    [ -f "$rel.part/$f" ] || { rm -rf "$rel.part"; die "the release has no $f; nothing was installed."; }
  done
  [ "$(cat "$rel.part/VERSION")" = "$REL_VERSION" ] || { rm -rf "$rel.part"; die "the release's VERSION file does not match its manifest; nothing was installed."; }
  chmod 0755 "$rel.part/bin/vyre-server"
  : >"$rel.part/.complete"
  rm -rf "$rel"
  mv "$rel.part" "$rel"
}
# END release


cur_dir() { real_path "$DIR/current"; }
cur_version() { cat "$DIR/current/VERSION" 2>/dev/null || printf unknown; }

# dc ARGS...: docker compose for this install, project folder = the current release.
dc() {
  c=$(cur_dir)
  docker compose --project-directory "$c" --env-file "$DIR/compose.env" -f "$c/compose.server.yml" -f "$DIR/compose.override.yml" "$@"
}

lock_get() { sed -n "s/^$1=\\(.*\\)\$/\\1/p" "$(cur_dir)/images.lock" 2>/dev/null | head -n 1; }

port() { sed -n 's/^VYRE_PORT=//p' "$DIR/compose.env" 2>/dev/null | head -n 1 | grep . || printf 8420; }
health_url() {
  if [ "${VYRE_TEST_MODE:-0}" = 1 ] && [ -n "${VYRE_TEST_HEALTH_URL:-}" ]; then printf '%s' "$VYRE_TEST_HEALTH_URL"; return 0; fi
  printf 'http://127.0.0.1:%s/healthz' "$(port)"
}

# ---- start, stop, status, logs -----------------------------------------------------------------------------------------------------
cmd_start() { [ ! -f "$(PENDING_FILE)" ] || lock_update_operation; refresh_disk_env || true; ensure_userns_vm || true; dc up -d --remove-orphans --wait --wait-timeout "${VYRE_UP_WAIT:-180}"; }
cmd_stop() { dc stop; }
cmd_status() { dc ps; }
cmd_logs() {
  follow=1; svc=""
  for a in "$@"; do case "$a" in --no-follow) follow=0 ;; *) svc="$svc $a" ;; esac; done
  if [ "$follow" = 1 ]; then
    [ ! -t 1 ] || say "Following the log: new lines appear as they happen. Press Ctrl-C to stop (vyre-server logs --no-follow prints the last lines and exits)."
    # shellcheck disable=SC2086
    dc logs -f --tail 200 $svc
  else
    # shellcheck disable=SC2086
    dc logs --tail 200 $svc
  fi
}

# ---- claim ---------------------------------------------------------------------------------------------------------------------------
# vyred writes the owner's claim link to logs/claim-link.txt in its data directory (mode 0600) at each start while the Space is unclaimed, and deletes it once the claim
# succeeds. The link is a credential: this prints it to the terminal that asked, and nowhere else.
claim_file() { printf '%s/space/logs/claim-link.txt' "$DATA_DIR"; }
# login_name: who to ssh in as: root on a Linux server, the person's own account on a Mac (the server runs under it there)
login_name() { if [ "$(spacedb_os)" = Darwin ]; then id -un 2>/dev/null || printf you; else printf root; fi; }
cmd_claim_link() {
  f=$(claim_file)
  if [ -r "$f" ]; then
    link=$(cat "$f")
    printf '%s\n' "$link"
    # a server with no address of its own prints a link on this machine's own address (0.0.0.0 means "this machine"): say where it opens, on stderr so the link stays alone on stdout
    case "$link" in
      http://0.0.0.0:*|http://127.0.0.1:*|http://localhost:*)
        p=$(printf '%s' "$link" | sed -n 's|^http://[^:/]*:\([0-9]*\)/.*|\1|p')
        { say ""
          say "This link opens only on this server: it has no web address yet, and 0.0.0.0 is not an address you can open from another computer."
          say "  - In the Vyre app: choose Create a Space, then Team Space, and paste the link."
          say "  - In a browser on your own computer: run  ssh -L ${p:-8420}:127.0.0.1:${p:-8420} $(login_name)@$(hostname -f 2>/dev/null || hostname)  and, while that stays open, paste the link above with 0.0.0.0 changed to localhost."
          say "  - For a web address your whole team can open, install with your own name: --domain vyre.example.com (docs/getting-started.md)."
        } >&2 ;;
    esac
    return 0
  fi
  if [ -e "$f" ] && [ "$(spacedb_os)" = Darwin ]; then die "cannot read $f. Run it as the account that installed the server."; fi
  [ ! -e "$f" ] || die "cannot read $f. Run it as root: sudo vyre-server claim-link"
  die "there is no claim link: the Space is claimed already, or the server has not started yet (vyre-server status)."
}

# ---- doctor ------------------------------------------------------------------------------------------------------------------------
FINDINGS=""
DOWN=0
# finding KEY STATE DETAIL
finding() {
  FINDINGS="$FINDINGS
$1	$2	$3"
  [ "$2" != down ] || DOWN=1
}

json_str() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\t' '  '; }

# BEGIN spacedb
# The Space's databases (the data folder's space/, SQLite in WAL mode) are open in vyred while it runs. A tool on this computer opens one only when the Docker engine runs on this
# computer's own kernel: then its locks and its shared-memory index are the ones the server uses. On a Mac, and with any engine in a virtual machine (Docker Desktop, OrbStack,
# Colima), the server runs on another kernel: a host sqlite3 or node that opens the file through the shared folder cannot see the server's locks, runs recovery and checkpoints
# against a file the server is writing, and damages it (12 Nov 2026, a Mac mini: logs.db and modules.db, during an update's backup). There every read, snapshot and check goes into
# the virtual machine: `docker exec` into the running vyred (the writer's own kernel), else `docker run` of the server's image with nothing else running. A copy the server never has
# open (a staged backup, an unpacked one) may still use host tools. This block is the same text in vyre-server and in both installers (a test compares them).
SPACEDB_SAME=""
spacedb_os() { if [ "${VYRE_TEST_MODE:-0}" = 1 ] && [ -n "${VYRE_TEST_OS:-}" ]; then printf '%s' "$VYRE_TEST_OS"; else uname -s; fi; }
# engine_same_kernel: 0 when the Docker engine shares this computer's kernel. A Mac: never (Docker always runs in a virtual machine there). Linux: the engine's kernel (docker info's
# KernelVersion) is this one's (uname -r), and the engine is not Docker Desktop. An engine that does not answer on Linux counts as this kernel: no other kernel then has the files open.
engine_same_kernel() {
  if [ -z "$SPACEDB_SAME" ]; then
    if [ "$(spacedb_os)" = Darwin ]; then SPACEDB_SAME=1
    else
      _sk=$(docker info --format '{{.KernelVersion}}|{{.OperatingSystem}}' 2>/dev/null | head -n 1) || _sk=""
      case "$_sk" in
        ""|"|"*) SPACEDB_SAME=0 ;;
        *"Docker Desktop"*) SPACEDB_SAME=1 ;;
        "$(uname -r)|"*) SPACEDB_SAME=0 ;;
        *) SPACEDB_SAME=1 ;;
      esac
    fi
  fi
  return "$SPACEDB_SAME"
}
# spacedb_live FILE: the file is under the Space folder the server has open.
spacedb_live() { case "$1" in "$DATA_DIR/space/"*) return 0 ;; esac; return 1; }
# spacedb_vyred: the running vyred container whose /data is this install's Space folder (a bind of it, or a local volume bound to it), or nothing.
spacedb_vyred() {
  for _sc in $(docker ps -q --filter "label=com.docker.compose.service=vyred" 2>/dev/null); do
    _sm=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Type}} {{.Name}} {{.Source}}{{end}}{{end}}' "$_sc" 2>/dev/null) || continue
    _st=${_sm%% *}; _sr=${_sm#* }; _sn=${_sr%% *}; _ss=${_sr#* }
    case "$_st" in
      bind) [ "$_ss" = "$DATA_DIR/space" ] || continue ;;
      volume) [ "$(docker volume inspect -f '{{index .Options "device"}}' "$_sn" 2>/dev/null)" = "$DATA_DIR/space" ] || continue ;;
      *) continue ;;
    esac
    [ "$(docker inspect -f '{{.State.Running}} {{.State.Restarting}}' "$_sc" 2>/dev/null)" = "true false" ] || continue
    printf '%s' "$_sc"; return 0
  done
  return 1
}
# The node programs (argv[1] is the database). The snapshot is VACUUM INTO a private file in the container's own /tmp, checked with integrity_check, then streamed to stdout: the host
# writes it where the backup wants it, under the host's own umask and owner, and no host folder is opened to the container for writing.
SPACEDB_SNAP_JS='const{DatabaseSync}=require("node:sqlite"),fs=require("node:fs"),os=require("node:os"),p=require("node:path");const w=fs.mkdtempSync(p.join(os.tmpdir(),"vyre-snap-")),t=p.join(w,"s.db");let c=0;try{const d=new DatabaseSync(process.argv[1],{readOnly:true});d.exec("PRAGMA busy_timeout=30000");d.prepare("VACUUM INTO ?").run(t);d.close();const o=new DatabaseSync(t,{readOnly:true});const r=o.prepare("PRAGMA integrity_check").get();o.close();if(r.integrity_check!=="ok")throw new Error("integrity_check: "+r.integrity_check);const f=fs.openSync(t,"r"),b=Buffer.alloc(1048576);let n;while((n=fs.readSync(f,b,0,b.length,null))>0){let k=0;while(k<n){try{k+=fs.writeSync(1,b,k,n-k)}catch(e){if(e.code!=="EAGAIN")throw e;Atomics.wait(new Int32Array(new SharedArrayBuffer(4)),0,0,5)}}}fs.closeSync(f)}catch(e){process.stderr.write(String(e&&e.message||e)+"\n");c=1}finally{fs.rmSync(w,{recursive:true,force:true})}process.exit(c)'
# the host's own node writes the copy itself (the same program as before this block; a host folder is its own to write)
SPACEDB_HOST_SNAP_JS='const{DatabaseSync}=require("node:sqlite");const d=new DatabaseSync(process.argv[1]);d.exec("PRAGMA busy_timeout=30000");d.prepare("VACUUM INTO ?").run(process.argv[2]);d.close();const o=new DatabaseSync(process.argv[2]);const r=o.prepare("PRAGMA integrity_check").get();o.close();if(r.integrity_check!=="ok"){console.error("integrity_check: "+r.integrity_check);process.exit(1)}'
SPACEDB_CHECK_JS='const{DatabaseSync}=require("node:sqlite");const d=new DatabaseSync(process.argv[1],{readOnly:true});process.exit(d.prepare("PRAGMA integrity_check").get().integrity_check==="ok"?0:1)'
SPACEDB_QUERY_JS="try{const {DatabaseSync}=require('node:sqlite');const d=new DatabaseSync(process.argv[1],{readOnly:true});d.exec('PRAGMA busy_timeout='+process.argv[3]);console.log(d.prepare(process.argv[2]).get().n)}catch(e){process.exit(2)}"
# spacedb_node JS ARGS...: node in the virtual machine with /data = the Space folder: in the running vyred when there is one (SPACEDB_CID), else a one-shot container of the server's image.
spacedb_node() {
  if [ -n "$SPACEDB_CID" ]; then docker exec "$SPACEDB_CID" node --no-warnings -e "$@"
  else docker run --rm --network none --user 1000:1000 -v "$DATA_DIR/space:/data" --entrypoint node "$SPACEDB_IMG" --no-warnings -e "$@"; fi
}
# spacedb_vm KIND DB [ARG]: as space_db, inside the virtual machine. 3 when there is no safe reader (no Docker, no running vyred and no server image named).
spacedb_vm() {
  command -v docker >/dev/null 2>&1 || return 3
  SPACEDB_CID=$(spacedb_vyred) || SPACEDB_CID=""
  SPACEDB_IMG=$(sed -n 's/^VYRE_IMAGE=//p' "$DIR/compose.env" 2>/dev/null | head -n 1)
  [ -n "$SPACEDB_CID$SPACEDB_IMG" ] || return 3
  _sp=/data/${2#"$DATA_DIR/space/"}
  case "$1" in
    snapshot)
      rm -f "$3" "$3.part"
      if spacedb_node "$SPACEDB_SNAP_JS" "$_sp" >"$3.part" && [ "$(head -c 15 "$3.part" 2>/dev/null)" = "SQLite format 3" ]; then mv -f "$3.part" "$3"; return 0; fi
      rm -f "$3.part"; return 1 ;;
    check) spacedb_node "$SPACEDB_CHECK_JS" "$_sp" ;;
    query) spacedb_node "$SPACEDB_QUERY_JS" "$_sp" "$3" "${VYRE_TEST_SQLITE_TIMEOUT:-3000}" 2>/dev/null ;;
    *) return 1 ;;
  esac
}
# spacedb_host KIND DB [ARG]: the host's own tools, in order: sqlite3, node (22.5 or newer), else the server image with only that folder mounted.
spacedb_host() {
  _sd=$(dirname "$2"); _sb=$(basename "$2")
  _simg=$(sed -n 's/^VYRE_IMAGE=//p' "$DIR/compose.env" 2>/dev/null | head -n 1)
  _snode=0
  if command -v node >/dev/null 2>&1 && node --no-warnings -e "require('node:sqlite')" >/dev/null 2>&1; then _snode=1; fi
  case "$1" in
    snapshot)
      rm -f "$3"
      if command -v sqlite3 >/dev/null 2>&1; then
        sqlite3 -cmd ".timeout 30000" "$2" "VACUUM INTO '$(printf '%s' "$3" | sed "s/'/''/g")'" >/dev/null && [ "$(sqlite3 "$3" 'PRAGMA integrity_check')" = ok ] && return 0
        rm -f "$3"
      fi
      if [ "$_snode" = 1 ]; then node --no-warnings -e "$SPACEDB_HOST_SNAP_JS" "$2" "$3" && return 0; rm -f "$3"; return 1; fi
      [ -n "$_simg" ] && command -v docker >/dev/null 2>&1 || return 3
      docker run --rm --network none --user 1000:1000 -v "$_sd:/in" --entrypoint node "$_simg" --no-warnings -e "$SPACEDB_SNAP_JS" "/in/$_sb" >"$3.part" && mv -f "$3.part" "$3" && return 0
      rm -f "$3.part"; return 1 ;;
    check)
      if command -v sqlite3 >/dev/null 2>&1; then [ "$(sqlite3 "$2" 'PRAGMA integrity_check' 2>/dev/null)" = ok ]; return; fi
      if [ "$_snode" = 1 ]; then node --no-warnings -e "$SPACEDB_CHECK_JS" "$2"; return; fi
      [ -n "$_simg" ] && command -v docker >/dev/null 2>&1 || return 3
      docker run --rm --network none --user 1000:1000 -v "$_sd:/in:ro" --entrypoint node "$_simg" --no-warnings -e "$SPACEDB_CHECK_JS" "/in/$_sb" ;;
    query)
      _sto=${VYRE_TEST_SQLITE_TIMEOUT:-3000}
      if command -v sqlite3 >/dev/null 2>&1; then sqlite3 -readonly -cmd ".timeout $_sto" "$2" "$3" 2>/dev/null; return; fi
      if [ "$_snode" = 1 ]; then node --no-warnings -e "$SPACEDB_QUERY_JS" "$2" "$3" "$_sto" 2>/dev/null; return; fi
      [ -n "$_simg" ] && command -v docker >/dev/null 2>&1 || return 3
      docker run --rm --network none --user 1000:1000 -v "$_sd:/in:ro" --entrypoint node "$_simg" --no-warnings -e "$SPACEDB_QUERY_JS" "/in/$_sb" "$3" "$_sto" 2>/dev/null ;;
    *) return 1 ;;
  esac
}
# space_db KIND DB [ARG]: the one way to open a database. KIND is snapshot (ARG = where the checked copy goes), check (integrity_check is ok) or query (ARG = SQL with one row and a
# column n; n is printed). 0 = done, 1 = it failed (a damaged or busy database), 3 = no safe reader on this computer. Every caller in these scripts goes through here.
space_db() {
  if spacedb_live "$2" && ! engine_same_kernel; then spacedb_vm "$@" && return 0 || return $?; fi
  spacedb_host "$@" && return 0 || return $?
}

# space_serves_domain: 0 = the Space serves its own domain (network_config mode own_domain, set at install or later in the Console); 1 = it does not (the query ran, the table is there,
# no row says so); 2 = cannot tell (no reader, a busy or missing database, any error or odd answer). Callers change the ports only on 0 or 1.
space_serves_domain() {
  [ -f "$DATA_DIR/space/modules.db" ] || return 2
  _so=$(space_db query "$DATA_DIR/space/modules.db" "SELECT count(*) AS n FROM network_config WHERE id = 1 AND mode = 'own_domain'") || return 2
  case "$_so" in 1) return 0 ;; 0) return 1 ;; *) return 2 ;; esac
}
# END spacedb

# refresh_disk_env: at each start the disk is looked at again and what the Console is told (VYRE_DISK_ENCRYPTION in compose.env) follows it: a verified encryption layer, else the person's recorded
# statement (plain or provider), else nothing. A recorded value is never trusted over what can be seen.
refresh_disk_env() {
  [ -f "$DIR/compose.env" ] || return 0
  disk_encrypted "$DATA_DIR" && rc=0 || rc=$?
  enc_choice
  k=$enc_kind
  if [ "$rc" = 0 ]; then if crypt_on_file; then k=detected_file; else k=detected; fi; else case "$k" in plain|provider) ;; *) k="" ;; esac; fi
  since=$enc_since
  [ -n "$since" ] || since=$(date -u +%Y-%m-%d)
  # Docker's data root: agent browser sign-ins live in Docker volumes there. The server inside Docker cannot see it, so the host says what it sees: encrypted, plain, or unknown (cannot tell).
  rd=$(docker_root_dir); rstate=""
  [ -z "$rd" ] || rstate=$(docker_root_state "$rd")
  { grep -v -e '^VYRE_DISK_ENCRYPTION=' -e '^VYRE_DISK_ENCRYPTION_SINCE=' -e '^VYRE_DOCKER_ROOT_DIR=' -e '^VYRE_DOCKER_ROOT_STATE=' "$DIR/compose.env" || true
    [ -z "$k" ] || printf 'VYRE_DISK_ENCRYPTION=%s\nVYRE_DISK_ENCRYPTION_SINCE=%s\n' "$k" "$since"
    [ -z "$rstate" ] || printf 'VYRE_DOCKER_ROOT_DIR=%s\nVYRE_DOCKER_ROOT_STATE=%s\n' "$rd" "$rstate"; } >"$DIR/compose.env.new" || { rm -f "$DIR/compose.env.new"; return 1; }
  if cmp -s "$DIR/compose.env" "$DIR/compose.env.new"; then rm -f "$DIR/compose.env.new"; else mv -f "$DIR/compose.env.new" "$DIR/compose.env"; fi
}

# docker_root_state DIR: encrypted, plain, or unknown. Unknown is not plain: on a Mac the root is inside Docker's virtual machine (no folder here to look at), and a root that cannot be resolved cannot be judged.
docker_root_state() {
  [ "$(spacedb_os)" != Darwin ] || { printf unknown; return 0; }
  _r=$(real_path "$1")
  [ -d "$_r" ] || { printf unknown; return 0; }
  disk_encrypted "$_r" && _rc=0 || _rc=$?
  case "$_rc" in 0) printf encrypted ;; 1) printf plain ;; *) printf unknown ;; esac
}

# docker_root_dir: where Docker keeps its data (docker info), or nothing when Docker does not answer.
docker_root_dir() {
  if [ "${VYRE_TEST_MODE:-0}" = 1 ] && [ -n "${VYRE_TEST_DOCKER_ROOT:-}" ]; then printf '%s' "$VYRE_TEST_DOCKER_ROOT"; return 0; fi
  docker info --format '{{.DockerRootDir}}' 2>/dev/null | head -n 1
}

# crypt_on_file: the encrypted volume under the data directory is a loop device, a file on some disk (its key may sit beside it; this server cannot see where the key is).
crypt_on_file() {
  m=/proc/mounts; l=lsblk
  if [ "${VYRE_TEST_MODE:-0}" = 1 ]; then m=${VYRE_TEST_PROC_MOUNTS:-/proc/mounts}; [ -z "${VYRE_TEST_LSBLK:-}" ] || l=$VYRE_TEST_LSBLK; fi
  src=$(awk -v d="$DATA_DIR" '{ t = $2 } (t == "/" || d == t || index(d, t "/") == 1) && length(t) >= best { best = length(t); line = $1 } END { print line }' "$m" 2>/dev/null)
  [ -n "$src" ] || return 1
  "$l" -s -n -o TYPE "$src" 2>/dev/null | grep -qx loop
}

# enc_choice: sets enc_kind and enc_since to what the person chose about a disk that is not visibly encrypted: state/encryption, else (an install made before that file, or one whose
# file was lost) the plain or provider choice compose.env carries for the Console.
enc_choice() {
  enc_kind=$(sed -n 's/^kind=//p' "$DIR/state/encryption" 2>/dev/null | head -n 1)
  enc_since=$(sed -n 's/^since=//p' "$DIR/state/encryption" 2>/dev/null | head -n 1)
  if [ -z "$enc_kind" ]; then
    case "$(sed -n 's/^VYRE_DISK_ENCRYPTION=//p' "$DIR/compose.env" 2>/dev/null | head -n 1)" in
      plain) enc_kind=plain ;;
      provider) enc_kind=provider ;;
    esac
    [ -z "$enc_kind" ] || enc_since=$(sed -n 's/^VYRE_DISK_ENCRYPTION_SINCE=//p' "$DIR/compose.env" 2>/dev/null | head -n 1)
  fi
  return 0
}

check_all() {
  # the volume the data lives on, checked now (never trusted from a record), and what the person said about it when it is not visibly encrypted
  disk_encrypted "$DATA_DIR" && rc=0 || rc=$?
  enc_choice
  host=$(spacedb_os)
  case "$rc" in
    0) if crypt_on_file; then finding host.disk_encrypted degraded "The data directory $DATA_DIR is on an encrypted volume that is a file on this disk. This server cannot tell where its key is kept: a key on this same disk protects nothing."
       else finding host.disk_encrypted healthy "The data directory $DATA_DIR is on an encrypted volume (verified here; where its key is kept is not visible)."; fi ;;
    *) case "$enc_kind" in
         plain) finding host.disk_encrypted degraded "The data is NOT encrypted at rest. You chose to install on a plain disk${enc_since:+ on $enc_since}: anyone who gets a copy of this disk, a snapshot or a backup can read it." ;;
         provider) finding host.disk_encrypted degraded "Not verified: your provider's encryption, as you stated${enc_since:+ on $enc_since}. This server cannot check it; confirm it with your provider." ;;
         *) case "$rc" in
              1) if [ "$host" = Darwin ]; then finding host.disk_encrypted down "The data directory $DATA_DIR is not on an encrypted volume. Turn on FileVault (System Settings > Privacy & Security > FileVault), or run the Mac installer again with --allow-plain-disk."
                 else finding host.disk_encrypted down "The data directory $DATA_DIR is not on an encrypted volume. Re-run the installer with --provider-encrypted (the provider's encrypted volume) or --allow-plain-disk (see its --help)."; fi ;;
              *) if [ "$host" = Darwin ]; then finding host.disk_encrypted down "Could not tell whether $DATA_DIR is on an encrypted volume (diskutil gave no FileVault answer for it)."
                 else finding host.disk_encrypted down "Could not tell whether $DATA_DIR is on an encrypted volume (no /proc/mounts or lsblk answer)."; fi ;;
            esac ;;
       esac ;;
  esac
  # Docker's data root: agent browser sign-ins (the Chrome profiles of agent computers and of the Space browser) are stored unsealed in Docker volumes there: Vyre does not encrypt them itself, so only that disk's
  # encryption protects them. A finding of its own; it only ever reports (an existing server is never stopped or refused by it).
  rd=$(docker_root_dir)
  if [ -n "$rd" ]; then
    rstate=$(docker_root_state "$rd")
    case "$rstate" in
      encrypted) finding host.docker_root healthy "Docker's data root $rd is on an encrypted volume (verified here). Agent browser sign-ins (agent computers' and the Space browser's Chrome profiles) are stored unsealed in Docker volumes there; that disk's encryption protects them." ;;
      unknown) finding host.docker_root degraded "Could not tell whether Docker's data root ($rd) is encrypted: it is not a disk this server can look at (as when Docker runs in a virtual machine, as on a Mac, where FileVault covers that machine's disk image). Agent browser sign-ins (agent computers' and the Space browser's Chrome profiles) are stored unsealed in Docker volumes there. Next: check that disk's encryption yourself." ;;
      *)
        if [ "$rc" = 0 ]; then finding host.docker_root degraded "Docker's data root ($rd) is not on an encrypted volume, but the Space's data is. Agent browser sign-ins (agent computers' and the Space browser's Chrome profiles) are stored unsealed in Docker volumes there, so they are not encrypted at rest. Next: move Docker's data root onto the encrypted volume, or encrypt its disk."
        else
          case "$enc_kind" in
            plain) finding host.docker_root degraded "Agent browser sign-ins (agent computers' and the Space browser's Chrome profiles) are stored unsealed in Docker volumes on Docker's disk ($rd), which is not encrypted at rest (the plain-disk choice you made covers it). Next: move Docker's data root and the data onto an encrypted volume." ;;
            provider) finding host.docker_root degraded "Not verified: agent browser sign-ins (agent computers' and the Space browser's Chrome profiles) are stored unsealed in Docker volumes on Docker's disk ($rd). Your provider's encryption, as you stated, covers them only if Docker's data root is on that volume. Next: confirm that with your provider, or move Docker's data root onto the encrypted volume." ;;
            *) finding host.docker_root degraded "Agent browser sign-ins (agent computers' and the Space browser's Chrome profiles) are stored unsealed in Docker volumes on Docker's disk ($rd), which is not verified encrypted. Next: move Docker's data root onto an encrypted volume, or encrypt its disk." ;;
          esac
        fi ;;
    esac
  fi
  # room to work
  free_mb=$(df -Pm "$DATA_DIR" 2>/dev/null | awk 'NR==2 {print $4}')
  if [ -z "$free_mb" ]; then finding host.disk_space degraded "Could not read the free space of $DATA_DIR."
  elif [ "$free_mb" -lt 1024 ]; then finding host.disk_space down "Only $free_mb MB free on the data volume. Free space or grow it."
  elif [ "$free_mb" -lt 5120 ]; then finding host.disk_space degraded "$free_mb MB free on the data volume; updates and backups need room."
  else finding host.disk_space healthy "$free_mb MB free on the data volume."
  fi
  # docker and the stack
  if ! command -v docker >/dev/null 2>&1; then
    finding host.docker down "Docker is not installed."
  elif ! docker info >/dev/null 2>&1; then
    if [ "$host" = Darwin ]; then finding host.docker down "Docker is not running. Open Docker Desktop or OrbStack (or run: colima start) and wait for it to start."
    else finding host.docker down "Docker is not running. Start it: systemctl start docker."
    fi
  else
    finding host.docker healthy "Docker answers."
    ps=$(dc ps --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null || true)
    vy=$(printf '%s\n' "$ps" | awk '$1 == "vyred" { print $2 " " $3 }')
    cd=$(printf '%s\n' "$ps" | awk '$1 == "caddy" { print $2 }')
    case "$vy" in
      "running healthy") finding host.vyred healthy "vyred is running and healthy." ;;
      "running starting") finding host.vyred degraded "vyred is still starting." ;;
      "") finding host.vyred down "vyred is not running. Start it: vyre-server start." ;;
      *) finding host.vyred down "vyred is $vy. Read: vyre-server logs vyred." ;;
    esac
    case "$cd" in
      running) finding host.caddy healthy "Caddy is running." ;;
      "") finding host.caddy down "Caddy is not running. Start it: vyre-server start." ;;
      *) finding host.caddy down "Caddy is $cd. Read: vyre-server logs caddy." ;;
    esac
    # the sites runner (the one service holding the Docker socket): sites stop deploying without it, the Space does not, so it is never a reason to roll an update back
    sr=$(printf '%s\n' "$ps" | awk '$1 == "sites-runner" { print $2 }')
    case "$sr" in
      running) finding host.sites_runner healthy "The sites runner is running." ;;
      "") finding host.sites_runner degraded "The sites runner is not running, so sites cannot deploy. Start it: vyre-server start." ;;
      *) finding host.sites_runner degraded "The sites runner is $sr. Read: vyre-server logs sites-runner." ;;
    esac
    wi=$(lock_get VYRE_WORKSPACE_IMAGE)
    if [ -n "$wi" ]; then
      if docker image inspect "$wi" >/dev/null 2>&1; then finding host.workspace_image healthy "The agent workspace image is pulled."
      else finding host.workspace_image degraded "The agent workspace image is not pulled yet; agent terminals cannot start. Run: docker pull $wi"
      fi
    fi
    ai=$(lock_get VYRE_AGENT_IMAGE)
    if [ -n "$ai" ]; then
      # the old per-agent desktop image: only a server that still has an old desktop needs it, and such a server holds it already. Its absence is not a fault (it does not exist for
      # Apple silicon), so nothing is reported then; agents use a workspace and the Space browser, which have their own lines here.
      if docker image inspect "$ai" >/dev/null 2>&1; then finding host.agent_image healthy "The agent computer image is pulled."; fi
    fi
    bi=$(lock_get VYRE_BROWSER_IMAGE)
    if [ -n "$bi" ]; then
      if docker image inspect "$bi" >/dev/null 2>&1; then finding host.browser_image healthy "The Space browser image is pulled."
      else finding host.browser_image degraded "The Space browser image is not pulled yet; agents browse without it until it is. Run: docker pull $bi"
      fi
    fi
  fi
  # the host lets the engine sandbox make user namespaces
  if [ -e "$(userns_proc)" ]; then
    if [ "$(cat "$(userns_proc)" 2>/dev/null)" = 1 ]; then finding host.userns degraded "kernel.apparmor_restrict_unprivileged_userns is 1, so the engine sandbox (bubblewrap) fails and agent turns error. Fix: vyre-server fix-userns."
    else finding host.userns healthy "The host allows the user namespaces the engine sandbox needs."
    fi
  elif [ "$(uname -s)" = Darwin ] && [ "${VYRE_TEST_MODE:-0}" != 1 ]; then
    # on a Mac the setting lives in Docker's virtual machine; `start` turns it off there each time (ensure_userns_vm)
    case "$(userns_vm_state)" in
      1) finding host.userns degraded "Docker's virtual machine has kernel.apparmor_restrict_unprivileged_userns set to 1, so the engine sandbox (bubblewrap) fails and agent turns error. Fix: vyre-server fix-userns." ;;
      0) finding host.userns healthy "Docker's virtual machine allows the user namespaces the engine sandbox needs." ;;
    esac
  fi
  # the server answers
  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 5 "$(health_url)" >/dev/null 2>&1; then
    finding host.healthz healthy "vyred answers /healthz."
  else
    finding host.healthz down "vyred does not answer on 127.0.0.1:$(port)."
  fi
  # the install itself
  if [ -f "$DIR/current/VERSION" ] && [ -f "$DIR/vyre.env" ]; then finding host.release healthy "Vyre Server $(cur_version) on the $CHANNEL channel."
  else finding host.release down "No release is installed at $DIR. Run the installer again."
  fi
  if [ "$(uname -s)" = Darwin ] && [ "${VYRE_TEST_MODE:-0}" != 1 ]; then
    if launchctl print "gui/$(id -u)/ai.vyre.server-update" >/dev/null 2>&1; then finding host.update_timer healthy "The daily update check is on."
    else finding host.update_timer degraded "The daily update check is off. Run the Mac installer again to turn it on."
    fi
  elif command -v systemctl >/dev/null 2>&1 && [ "${VYRE_TEST_MODE:-0}" != 1 ]; then
    if systemctl is-enabled vyre-server-update.timer >/dev/null 2>&1; then finding host.update_timer healthy "The daily update check is on."
    else finding host.update_timer degraded "The daily update check is off. Turn it on: systemctl enable --now vyre-server-update.timer."
    fi
  fi
}

cmd_doctor() {
  json=0; quiet=0
  for a in "$@"; do case "$a" in --json) json=1 ;; --quiet) quiet=1 ;; *) die "doctor takes --json or --quiet" 2 ;; esac; done
  check_all
  if [ "$json" = 1 ]; then
    first=1
    printf '{"ok":%s,"version":"%s","findings":[' "$([ "$DOWN" = 0 ] && printf true || printf false)" "$(json_str "$(cur_version)")"
    printf '%s\n' "$FINDINGS" | while IFS="$(printf '\t')" read -r k s d; do
      [ -n "$k" ] || continue
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"key":"%s","state":"%s","detail":"%s"}' "$k" "$s" "$(json_str "$d")"
    done
    printf ']}\n'
  elif [ "$quiet" = 0 ]; then
    printf '%s\n' "$FINDINGS" | while IFS="$(printf '\t')" read -r k s d; do
      [ -n "$k" ] || continue
      case "$s" in healthy) m="ok  " ;; degraded) m="warn" ;; *) m="DOWN" ;; esac
      printf '%s %-22s %s\n' "$m" "$k" "$d"
    done
  fi
  [ "$DOWN" = 0 ]
}

# ---- backup, update, rollback ------------------------------------------------------------------------------------------------------
# backup_data TAG: stops the server, takes a consistent copy of the Space and Caddy's certificates into a staging folder, tars the copy, prunes old backups.
# The caller starts the server again. Why a copy first: tar over live files fails with "file changed as we read it" whenever anything still writes under the data
# folder (agent computers, a daemon that is slow to stop). Each SQLite database is taken with VACUUM INTO, which reads one consistent snapshot even while a writer
# keeps going and leaves out the -wal and -shm files. Every other file is copied; a file that vanishes or changes during that copy cannot fail the backup.

# is_sqlite FILE: the file starts with the SQLite header.
is_sqlite() { [ "$(head -c 15 "$1" 2>/dev/null)" = "SQLite format 3" ]; }

# sqlite_snapshot SRC DST: one consistent copy of a database, checked with integrity_check (space_db: through the server's own kernel when the database is live and Docker runs in a VM).
sqlite_snapshot() { space_db snapshot "$1" "$2"; }

# stage_copy SRC_ROOT DST_ROOT: every file under SRC_ROOT into DST_ROOT; SQLite databases by snapshot, the rest by copy. Returns 1 when a database would not copy cleanly, 3 when this
# computer has no safe way to read the live databases (space_db), after saying so.
stage_copy() {
  mkdir -p "$2"
  # Files other than databases and their journals. tar exits 1 for a file that changed or vanished while it was read; the copy still holds the rest. Databases are left out here: a plain
  # copy of a live one is torn, and each is taken below as a snapshot (a file with a database's name that is not SQLite is copied there as it is).
  tar -C "$1" -cf - --exclude='*.db' --exclude='*.sqlite' --exclude='*.sqlite3' --exclude='*.db-wal' --exclude='*.db-shm' --exclude='*.db-journal' --exclude='*.sqlite-wal' --exclude='*.sqlite-shm' --exclude='*.sqlite3-wal' --exclude='*.sqlite3-shm' . 2>/dev/null | tar -C "$2" -xf - 2>/dev/null || true
  list=$2.dblist
  find "$1" -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \) >"$list" 2>/dev/null || true
  while IFS= read -r f; do
    dst=$2/${f#"$1"/}
    mkdir -p "$(dirname "$dst")"
    if ! is_sqlite "$f"; then cp -p "$f" "$dst" 2>/dev/null || true; continue; fi
    n=0
    while :; do
      sqlite_snapshot "$f" "$dst" && break || src=$?
      if [ "$src" = 3 ]; then
        printf 'vyre-server: the server runs in a virtual machine on this computer, so its databases are read only from inside it, and neither the server'"'"'s container nor its image is there (%s). Start Docker (and the server), then run this again.\n' "$f" >&2
        rm -f "$list"; return 3
      fi
      n=$((n + 1))
      if [ "$n" -ge 3 ]; then printf 'vyre-server: could not take a consistent copy of %s\n' "$f" >&2; rm -f "$list"; return 1; fi
      sleep 1
    done
  done <"$list"
  rm -f "$list"
}

# data_volumes: the Docker volumes that are the Space's data folder (a local volume bound to $DATA_DIR/space).
data_volumes() {
  docker volume ls -q 2>/dev/null | while IFS= read -r v; do
    dev=$(docker volume inspect -f '{{index .Options "device"}}' "$v" 2>/dev/null || true)
    [ "$dev" != "$DATA_DIR/space" ] || printf '%s\n' "$v"
  done
}

# stop_strays: `dc stop` stops what compose runs. Anything else with the data folder mounted (a container started outside compose) would still be writing, so it is stopped
# too, by name in the output, and written to state/stopped-strays for resume_strays to start again.
stop_strays() {
  : >"$DIR/state/stopped-strays" 2>/dev/null || { mkdir -p "$DIR/state"; : >"$DIR/state/stopped-strays"; }
  ids=""
  for v in $(data_volumes) "$DATA_DIR/space"; do
    ids="$ids $(docker ps -q --filter "volume=$v" 2>/dev/null || true)"
  done
  for id in $(printf '%s\n' $ids | sort -u); do
    nm=$(docker inspect -f '{{.Name}}' "$id" 2>/dev/null | sed 's|^/||')
    say "  Stopping $nm too: it was still running against the data folder after the server stopped."
    docker stop "$id" >/dev/null 2>&1 && printf '%s\n' "$id" >>"$DIR/state/stopped-strays"
  done
  return 0
}
resume_strays() {
  [ -f "$DIR/state/stopped-strays" ] || return 0
  while IFS= read -r id; do [ -z "$id" ] || docker start "$id" >/dev/null 2>&1 || true; done <"$DIR/state/stopped-strays"
  rm -f "$DIR/state/stopped-strays"
  return 0
}

# backup_fail MESSAGE [CODE]: remove the partial backup, put the server back as it was (it was stopped for the backup unless the backup was live), then stop with MESSAGE. A restore sets
# BACKUP_KEEP_STOPPED=1: it goes on with the server stopped whatever the backup of the current data did. CODE 6 means a database would not copy cleanly (it may be damaged).
backup_fail() {
  rm -rf "$out.part" "${STAGE:-/nonexistent-stage}"; STAGE=""
  if [ "${BACKUP_MODE:-stopped}" = stopped ] && [ "${BACKUP_KEEP_STOPPED:-0}" != 1 ]; then dc up -d --remove-orphans >/dev/null 2>&1 || true; resume_strays; fi
  die "$1" "${2:-1}"
}

# backup_data TAG [live]: without `live` the server is stopped first (an update wants the data still while it switches); with `live` it keeps running, and every database is
# still one consistent snapshot (VACUUM INTO reads a single transaction while writers go on).
backup_data() {
  BACKUP_MODE=${2:-stopped}
  [ -s "$DATA_DIR/space/events.db" ] || die "there is no Space in $DATA_DIR (no space/events.db): is the data volume mounted? No backup was written, and the earlier backups were left as they are."
  mkdir -p "$BACKUP_DIR" "$DIR/state"
  chmod 0700 "$BACKUP_DIR"
  out="$BACKUP_DIR/vyre-$1-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
  need_mb=$(du -sm "$DATA_DIR/space" "$DATA_DIR/caddy" 2>/dev/null | awk '{ n += $1 } END { print n + 0 }')
  free_mb=$(df -Pm "$BACKUP_DIR" | awk 'NR==2 {print $4}')
  [ "${free_mb:-0}" -gt "$((need_mb * 2 + 256))" ] || die "not enough room for a backup ($need_mb MB of data, $free_mb MB free); nothing was changed."
  if [ "$BACKUP_MODE" = stopped ]; then dc stop >/dev/null || true; stop_strays; fi
  umask 077
  STAGE=$(mktemp -d "$BACKUP_DIR/.stage.XXXXXX") || backup_fail "could not make room to stage the backup; nothing was changed."
  stage_copy "$DATA_DIR/space" "$STAGE/space" && sc=0 || sc=$?
  [ "$sc" != 3 ] || backup_fail "no backup was written; nothing was changed."
  [ "$sc" = 0 ] || backup_fail "the backup could not be written (a database would not copy cleanly); nothing was changed." 6
  if [ -d "$DATA_DIR/caddy" ]; then stage_copy "$DATA_DIR/caddy" "$STAGE/caddy" || backup_fail "the backup could not be written; nothing was changed."; else mkdir -p "$STAGE/caddy"; fi
  # The staged copy no longer changes, so tar has nothing to race with.
  tar -czf "$out.part" -C "$STAGE" space caddy || backup_fail "the backup could not be written; nothing was changed."
  tar -tzf "$out.part" >/dev/null || backup_fail "the backup did not read back; nothing was changed."
  tar -tzf "$out.part" | grep -q '^space/events.db$' || backup_fail "the backup holds no Space (space/events.db is missing); nothing was changed and the earlier backups were kept."
  rm -rf "$STAGE"; STAGE=""
  mv "$out.part" "$out"
  ls -1t "$BACKUP_DIR"/vyre-*.tar.gz 2>/dev/null | awk -v k="$KEEP_BACKUPS" 'NR > k' | while read -r old; do rm -f "$old"; done
  BACKUP_FILE=$out
}

# fs_device PATH: the device the folder holding PATH sits on (first column of df), to tell whether a backup is on the same disk as the data.
fs_device() {
  _p=$1
  if [ "${VYRE_TEST_MODE:-0}" = 1 ] && [ -n "${VYRE_TEST_FS_DEVICE:-}" ]; then
    printf '%s' "$VYRE_TEST_FS_DEVICE" | tr ',' '\n' | awk -F= -v p="$_p" 'index(p, $1) == 1 { print $2; exit }'
    return 0
  fi
  while [ ! -e "$_p" ]; do _p=$(dirname "$_p"); done
  df -P "$_p" 2>/dev/null | awk 'NR==2 {print $1}'
}
# backup_note: a backup on the same disk as the data is no protection against losing the disk or the server; say so, and the one command that copies it out.
backup_note() {
  if [ "$(fs_device "$(dirname "$BACKUP_FILE")")" = "$(fs_device "$DATA_DIR")" ]; then
    say "  This backup is on the same disk as the Space's data. If this server or its disk is lost, the backup is lost with it. Copy it somewhere else, from your own computer:"
    say "    scp $(login_name)@$(hostname -f 2>/dev/null || hostname):$BACKUP_FILE ."
  fi
}

# The server keeps running for a plain backup: nothing is stopped, nothing needs starting.
cmd_backup() {
  lock_update_operation
  backup_data manual live
  say "Backup written: $BACKUP_FILE"
  backup_note
}

# restore_check FILE DEST: the backup is a tar.gz of space/ and caddy/ only, no links, no path outside, and every database in it opens and passes integrity_check. Unpacked into DEST.
restore_check() {
  [ -f "$1" ] || die "no such backup file: $1"
  tar -tzf "$1" >/dev/null 2>&1 || die "$1 is not a readable backup (not a gzip tar, or cut short); nothing was changed."
  tar -tzf "$1" | awk '{ if ($0 ~ /^\// || $0 ~ /(^|\/)\.\.(\/|$)/ || ($0 != "space" && $0 != "space/" && $0 != "caddy" && $0 != "caddy/" && $0 !~ /^(space|caddy)\//)) bad = 1 } END { exit bad }' || die "$1 does not look like a Vyre Server backup (it holds paths other than space/ and caddy/); nothing was changed."
  tar -tvzf "$1" | awk '$1 ~ /^[lh]/ { bad = 1 } END { exit bad }' || die "$1 holds a link; nothing was changed."
  tar -tzf "$1" | grep -q '^space/events\.db$' || die "$1 has no space/events.db; it is not a backup of a Space; nothing was changed."
  mkdir -p "$2"
  tar -xzf "$1" -C "$2" || die "$1 could not be unpacked (cut short?); nothing was changed."
  [ -d "$2/space" ] || die "$1 has no space folder; nothing was changed."
  [ -d "$2/caddy" ] || mkdir -p "$2/caddy"
  list=$2/.dblist
  find "$2/space" -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \) >"$list"
  while IFS= read -r f; do
    is_sqlite "$f" || continue
    sqlite_check "$f" || die "a database in the backup fails integrity_check ($f); nothing was changed."
  done <"$list"
  rm -f "$list"
}

# sqlite_check DB: integrity_check is ok (space_db).
sqlite_check() { space_db check "$1"; }

cmd_restore() {
  file=""; yes=0; force=0
  for a in "$@"; do case "$a" in --yes|-y) yes=1 ;; --force) force=1 ;; -*) die "restore takes a backup file, --yes and --force" 2 ;; *) [ -z "$file" ] || die "restore takes one backup file" 2; file=$a ;; esac; done
  [ -n "$file" ] || die "restore needs the backup file: vyre-server restore FILE" 2
  lock_update_operation
  # a data folder that was set up on an encrypted volume which is not mounted now would be written onto this machine's plain disk (and covered when the volume is opened later): refuse before anything is made
  rkind=$(sed -n 's/^kind=//p' "$DIR/state/encryption" 2>/dev/null | head -n 1)
  rdir=$(sed -n 's/^data_dir=//p' "$DIR/state/encryption" 2>/dev/null | head -n 1)
  if [ "$force" != 1 ]; then
    rmiss=0
    case "$rkind" in
      detected|detected_file) disk_encrypted "$DATA_DIR" || rmiss=1 ;;
      provider) [ -z "$rdir" ] || [ "$rdir" != "$DATA_DIR" ] || [ -d "$DATA_DIR" ] || rmiss=1 ;;
    esac
    [ "$rmiss" = 0 ] || die "the data folder $DATA_DIR was set up on an encrypted volume ($rkind) that does not seem to be mounted now. Restoring now would write the Space onto this machine's plain disk. Mount or open the volume, then run the restore again. To restore onto the plain disk anyway, add --force. Nothing was changed." 7
  fi
  mkdir -p "$DATA_DIR"
  RSTAGE=$(mktemp -d "$DATA_DIR/.restore.XXXXXX") || die "could not make room to unpack the backup; nothing was changed."
  restore_check "$file" "$RSTAGE"
  if [ "$yes" != 1 ]; then
    [ -t 0 ] || die "restore replaces the Space's data; run it from a terminal, or pass --yes. Nothing was changed."
    printf 'This replaces the data of this server with %s. A backup of the current data is taken first. Type yes to go on: ' "$file"
    read -r answer || answer=""
    [ "$answer" = yes ] || die "not confirmed; nothing was changed."
  fi
  DAMAGED=0
  if [ -s "$DATA_DIR/space/events.db" ]; then
    HAD_SPACE=1
    say "  Backing up the current data first"
    # In a subshell so that a failure is this restore's to handle: with BACKUP_KEEP_STOPPED the server stays stopped either way. A database that will not copy (code 6) is what a damaged
    # Space looks like, and putting a backup back is the cure, so the current folder is kept whole under a dated name instead of being backed up.
    if ( trap - EXIT; BACKUP_KEEP_STOPPED=1; backup_data pre-restore; printf '%s\n' "$BACKUP_FILE" >"$RSTAGE/.backup-file" ); then
      BACKUP_FILE=$(cat "$RSTAGE/.backup-file"); rm -f "$RSTAGE/.backup-file"
      say "  Backed up to $BACKUP_FILE"
    else
      brc=$?
      if [ "$brc" != 6 ]; then dc up -d --remove-orphans >/dev/null 2>&1 || true; resume_strays; exit "$brc"; fi
      DAMAGED=1; BACKUP_FILE=""
      say "  The current data would not back up (a database in it is damaged or unreadable). It is kept whole beside the restored data instead, under a dated name."
    fi
  else
    # restoring into a lost or empty data folder is what restore is for: there is nothing to back up
    HAD_SPACE=0
    say "  There is no current Space in $DATA_DIR to back up; restoring."
    dc stop >/dev/null 2>&1 || true
    stop_strays
  fi
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  mkdir -p "$DATA_DIR"
  if [ -e "$DATA_DIR/space" ]; then mv "$DATA_DIR/space" "$DATA_DIR/space.replaced-$ts" || { dc up -d --remove-orphans >/dev/null 2>&1 || true; resume_strays; die "could not move the current data aside; nothing was changed."; }; fi
  if [ -d "$DATA_DIR/caddy" ]; then mv "$DATA_DIR/caddy" "$DATA_DIR/caddy.replaced-$ts"; fi
  mv "$RSTAGE/space" "$DATA_DIR/space" && mv "$RSTAGE/caddy" "$DATA_DIR/caddy" || restore_undo "$ts" "could not put the backup in place"
  # the server runs as uid 1000 and must be able to read what it is given: a backup taken with the host's sqlite3 holds root-owned 0600 files. On a Mac, Docker shares the folder under the
  # person's own account (and a person cannot chown to another user), so nothing is changed there.
  if [ "$(spacedb_os)" != Darwin ]; then
    chown -R 1000:1000 "$DATA_DIR/space" 2>/dev/null || [ "${VYRE_TEST_MODE:-0}" = 1 ] || restore_undo "$ts" "could not give the restored data to the server's user (uid 1000)"
  fi
  dc up -d --remove-orphans >/dev/null 2>&1 || restore_undo "$ts" "the server did not start on the restored data"
  wait_healthy || restore_undo "$ts" "the server did not pass its health check on the restored data"
  resume_strays
  if [ "$DAMAGED" = 1 ]; then
    mv "$DATA_DIR/space.replaced-$ts" "$DATA_DIR/space.damaged-$ts"
    rm -rf "$DATA_DIR/caddy.replaced-$ts" "$RSTAGE"; RSTAGE=""
    say "Restored from $file. The damaged data it replaced is kept in $DATA_DIR/space.damaged-$ts; delete it once the Space works."
    return 0
  fi
  rm -rf "$DATA_DIR/space.replaced-$ts" "$DATA_DIR/caddy.replaced-$ts" "$RSTAGE"; RSTAGE=""
  if [ "$HAD_SPACE" = 1 ]; then say "Restored from $file. The data it replaced is in $BACKUP_FILE."; else say "Restored from $file. There was no Space here before."; fi
}

# restore_undo TS WHY: put the data that was there back, start the server, and stop with WHY.
restore_undo() {
  dc stop >/dev/null 2>&1 || true
  if [ "${HAD_SPACE:-1}" != 1 ]; then
    # nothing was here before: the restored copy is all there is, so it is kept (stopped), not deleted
    die "$2. The restored data is still in $DATA_DIR/space (the server is stopped). Look at it and fix what failed, then start the server: vyre-server start. It came from $file."
  fi
  rm -rf "$DATA_DIR/space" "$DATA_DIR/caddy"
  if [ -d "$DATA_DIR/space.replaced-$1" ]; then mv "$DATA_DIR/space.replaced-$1" "$DATA_DIR/space"; fi
  if [ -d "$DATA_DIR/caddy.replaced-$1" ]; then mv "$DATA_DIR/caddy.replaced-$1" "$DATA_DIR/caddy"; else mkdir -p "$DATA_DIR/caddy"; fi
  dc up -d --remove-orphans >/dev/null 2>&1 || true
  resume_strays
  if [ "${DAMAGED:-0}" = 1 ]; then die "$2; the data that was there before (which would not back up) is back in $DATA_DIR/space."; fi
  die "$2; the data that was there before is back. Backup of it: $BACKUP_FILE"
}

record_update() {
  mkdir -p "$DIR/state"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" "$4" "$5" >>"$DIR/state/updates.tsv"
  printf '%s\n' "$3" >"$DIR/state/last-update-result"
}

set_current() {
  ln -sfn "releases/$1" "$DIR/current.new"
  mv -Tf "$DIR/current.new" "$DIR/current" 2>/dev/null || { rm -f "$DIR/current"; mv "$DIR/current.new" "$DIR/current"; }
}

# ---- the command, the host setting, the network ------------------------------------------------------------------------------------
BIN_FILE=${VYRE_BIN_DIR:-/usr/local/bin}/vyre-server
MARK="Vyre Server, installed by install.sh"

# hand_off ARGS...: this file is not the current release's (an old copy in /usr/local/bin, or a release that is no longer current): run the current release's instead,
# with the same arguments. VYRE_HANDOFF=1 marks the second hop, so two files that point at each other cannot loop.
hand_off() {
  [ "${VYRE_HANDOFF:-0}" != 1 ] || return 0
  cur="$DIR/current/bin/vyre-server"
  [ -f "$cur" ] || return 0
  me=$(real_path "$0")
  there=$(real_path "$cur")
  [ "$me" != "$there" ] || return 0
  VYRE_HANDOFF=1 VYRE_DIR="$DIR" exec sh "$cur" "$@"
}

# refresh_bin: the command in /usr/local/bin is a small wrapper that runs the current release's script. A full copy of an older script (what a server keeps from the day it was
# installed) is replaced by the wrapper, so every later fix runs. Only a file that is ours is touched: it names the mark or is a vyre-server script.
refresh_bin() {
  [ -f "$BIN_FILE" ] || return 0
  want=$(printf '#!/bin/sh\n# %s\nexec "%s/current/bin/vyre-server" "$@"\n' "$MARK" "$DIR")
  [ "$(cat "$BIN_FILE" 2>/dev/null)" != "$want" ] || return 0
  grep -q -e "$MARK" -e '^# vyre-server: run and look after Vyre Server' "$BIN_FILE" 2>/dev/null || return 0
  # a wrapper of ours that already runs the current release (the Mac installer's names Docker's folders and the Docker it was installed on) is left as it is
  if grep -q "$MARK" "$BIN_FILE" 2>/dev/null && grep -qx "exec \"$DIR/current/bin/vyre-server\" \"\$@\"" "$BIN_FILE" 2>/dev/null; then return 0; fi
  printf '%s\n' "$want" >"$BIN_FILE.new" 2>/dev/null || { rm -f "$BIN_FILE.new"; return 0; }
  chmod 0755 "$BIN_FILE.new" && mv -f "$BIN_FILE.new" "$BIN_FILE" || rm -f "$BIN_FILE.new"
}

# Ubuntu 24.04 stops unprivileged user namespaces (kernel.apparmor_restrict_unprivileged_userns=1), which bubblewrap, the engine's sandbox, needs.
userns_proc() { if [ "${VYRE_TEST_MODE:-0}" = 1 ] && [ -n "${VYRE_TEST_USERNS_PROC:-}" ]; then printf '%s' "$VYRE_TEST_USERNS_PROC"; else printf /proc/sys/kernel/apparmor_restrict_unprivileged_userns; fi; }
# ensure_userns: write /etc/sysctl.d/60-vyre-userns.conf and apply it, only on a kernel that has the setting.
ensure_userns() {
  [ -e "$(userns_proc)" ] || { ensure_userns_vm; return 0; }
  sd=${VYRE_SYSCTL_DIR:-/etc/sysctl.d}
  conf="$sd/60-vyre-userns.conf"
  mkdir -p "$sd" 2>/dev/null || return 0
  printf '# %s: the engine sandbox (bubblewrap) needs unprivileged user namespaces.\nkernel.apparmor_restrict_unprivileged_userns = 0\n' "$MARK" >"$conf.new" 2>/dev/null || { rm -f "$conf.new"; return 0; }
  mv -f "$conf.new" "$conf"
  if command -v sysctl >/dev/null 2>&1; then sysctl -p "$conf" >/dev/null 2>&1 || say "  Could not apply $conf now; it applies at the next boot."; fi
  return 0
}

# ensure_userns_vm: the same setting on a Mac, where Docker runs in a Linux virtual machine (Docker Desktop, OrbStack, Colima) and this script cannot see its kernel. Colima's machine is
# Ubuntu 24.04 with the restriction on: there bubblewrap answers "setting up uid map: Permission denied" and every agent turn that runs on the server fails. The setting is read through a
# container, and when it is 1 a one-shot privileged container of the server's own image (already here, named by digest) turns it off. It belongs to the machine's running kernel and a
# restart of the machine puts it back, so `start` does this every time. Nothing is done on a kernel without the setting, or when it is already 0.
ensure_userns_vm() {
  [ "$(uname -s)" = Darwin ] || return 0
  command -v docker >/dev/null 2>&1 || return 0
  _img=$(lock_get VYRE_IMAGE)
  [ -n "$_img" ] || return 0
  _f=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
  _v=$(docker run --rm --network none --entrypoint cat "$_img" "$_f" 2>/dev/null) || return 0
  [ "$_v" = 1 ] || return 0
  if docker run --rm --network none --privileged --user 0 --entrypoint sh "$_img" -c "echo 0 > $_f" >/dev/null 2>&1; then return 0; fi
  say "  Docker's virtual machine does not allow the user namespaces the engine sandbox needs, and this could not be changed. Agent turns that run on this server will fail until, inside that machine, kernel.apparmor_restrict_unprivileged_userns is 0."
  return 0
}
# userns_vm_state: 1, 0, or nothing when it cannot be read (no Docker, no image yet, or a kernel without the setting). For doctor on a Mac.
userns_vm_state() {
  command -v docker >/dev/null 2>&1 || return 0
  _img=$(lock_get VYRE_IMAGE)
  [ -n "$_img" ] || return 0
  docker run --rm --network none --entrypoint cat "$_img" /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null || true
}

# settle_caddy: Caddy shares vyred's network namespace (network_mode: service:vyred). When vyred is recreated, a Caddy left on the old one serves nothing, so it is recreated
# too whenever it is not attached to the vyred that runs now.
settle_caddy() {
  vid=$(dc ps -q vyred 2>/dev/null | head -n 1 || true)
  [ -n "$vid" ] || return 0
  vfull=$(docker inspect -f '{{.Id}}' "$vid" 2>/dev/null || printf '%s' "$vid")
  cid=$(dc ps -q caddy 2>/dev/null | head -n 1 || true)
  if [ -n "$cid" ]; then
    mode=$(docker inspect -f '{{.HostConfig.NetworkMode}}' "$cid" 2>/dev/null || true)
    [ "$mode" != "container:$vfull" ] || return 0
  fi
  dc up -d --force-recreate --no-deps caddy >/dev/null 2>&1 || return 1
}
# up_stack: bring the stack up on the current release, then make sure Caddy is on the new vyred.
up_stack() { dc up -d --remove-orphans >/dev/null 2>&1 || return 1; settle_caddy || true; }

# sync_image: compose.env names the image of the release `current` points at. Written whole and moved into place, so a cut-off write never leaves half a file.
sync_image() {
  img=$(sed -n 's/^VYRE_IMAGE=//p' "$DIR/current/images.lock" | head -n 1)
  [ -n "$img" ] || return 1
  # the agent computer image of this release, by digest: vyred asks for exactly this one (compose.server.yml VYRE_AGENT_COMPUTER_IMAGE). A release without one leaves the line out and the default applies.
  aimg=$(sed -n 's/^VYRE_AGENT_IMAGE=//p' "$DIR/current/images.lock" | head -n 1)
  # the Space browser image of this release, by digest (compose.server.yml VYRE_SPACE_BROWSER_IMAGE), the same way
  bimg=$(sed -n 's/^VYRE_BROWSER_IMAGE=//p' "$DIR/current/images.lock" | head -n 1)
  wimg=$(sed -n 's/^VYRE_WORKSPACE_IMAGE=//p' "$DIR/current/images.lock" | head -n 1)
  cp -p "$DIR/compose.env" "$DIR/compose.env.new" || return 1
  { grep -v -e '^VYRE_IMAGE=' -e '^VYRE_AGENT_COMPUTER_IMAGE=' -e '^VYRE_SPACE_BROWSER_IMAGE=' -e '^VYRE_WORKSPACE_IMAGE=' "$DIR/compose.env" || true; printf 'VYRE_IMAGE=%s\n' "$img"; [ -z "$aimg" ] || printf 'VYRE_AGENT_COMPUTER_IMAGE=%s\n' "$aimg"; [ -z "$bimg" ] || printf 'VYRE_SPACE_BROWSER_IMAGE=%s\n' "$bimg"; [ -z "$wimg" ] || printf 'VYRE_WORKSPACE_IMAGE=%s\n' "$wimg"; } >"$DIR/compose.env.new" || { rm -f "$DIR/compose.env.new"; return 1; }
  mv -f "$DIR/compose.env.new" "$DIR/compose.env"
  # a server with no domain (the relay) opens no port to the internet: 80 and 443 stay on this machine, unless the Space serves its own domain (set in the Console). In relay mode a site cannot have a custom domain, so nothing else is lost.
  if ! grep -q '^VYRE_ADDRESS=' "$DIR/compose.env"; then
    space_serves_domain && sd=0 || sd=$?
    case "$sd" in
      0)
        # the Space's own domain was set in the Console: its ports stay open (and an earlier closing of them is undone)
        if grep -q '^VYRE_BIND=' "$DIR/compose.env"; then awk '$0 !~ /^VYRE_BIND=/' "$DIR/compose.env" >"$DIR/compose.env.new" && mv -f "$DIR/compose.env.new" "$DIR/compose.env"; fi ;;
      1) grep -q '^VYRE_BIND=' "$DIR/compose.env" || printf 'VYRE_BIND=127.0.0.1\n' >>"$DIR/compose.env" ;;
      *) say "  Could not tell whether this server serves its own domain, so ports 80 and 443 were left exactly as they were." ;;
    esac
  fi
  refresh_disk_env || true
}

# An update writes state/update.pending (the release it left) before it switches, and removes it once it has settled. If the file is still there when the next
# command takes the lock, the update was cut off (killed, power loss): recover_pending puts the previous release back and starts it.
PENDING_FILE() { printf '%s/state/update.pending' "$DIR"; }
recover_pending() {
  pf=$(PENDING_FILE)
  if [ -f "$pf" ]; then
    back=$(sed -n 's|^releases/||p' "$pf" | head -n 1)
    if [ -n "$back" ] && [ -f "$DIR/releases/$back/.complete" ]; then
      say "  An earlier update was cut off; going back to $back."
      set_current "$back"
      sync_image || true
    fi
    rm -f "$pf"
  fi
  dc up -d --remove-orphans >/dev/null 2>&1 || true
}
update_interrupted() {
  trap '' INT TERM HUP
  printf 'vyre-server: interrupted; putting the server back as it was.\n' >&2
  recover_pending
  exit 143
}

wait_healthy() {
  n=0
  while [ "$n" -lt "${VYRE_UP_WAIT:-180}" ]; do
    check_quiet && return 0
    n=$((n + 3)); sleep 3
  done
  return 1
}
check_quiet() { FINDINGS=""; DOWN=0; check_all; [ "$DOWN" = 0 ]; }

prune_releases() {
  keep=$(cur_version)
  prev=$(sed -n 's|^releases/||p' "$DIR/previous" 2>/dev/null | head -n 1)
  ls -1t "$DIR/releases" 2>/dev/null | awk -v k="$KEEP_RELEASES" 'NR > k' | while read -r v; do
    [ "$v" = "$keep" ] || [ "$v" = "$prev" ] || rm -rf "$DIR/releases/$v"
  done
}

# prune_images: after a healthy update, remove the agent computer, workspace and Space browser images that no kept release names, so each update does not leave the last one behind (MLA had 16.6 GB).
# An image goes only when all of these hold: it is one of ours (pulled by digest from a repository named agent-computer, workspace or space-browser; or carrying the label ai.vyre.image; or an
# untagged image whose command is the agent computer's agentd), no kept release or compose.env names it, and no container, running or stopped, was made from it. A kept release is one prune_releases
# left: the current one and the one a rollback goes to. Images built or tagged by hand (no digest) are never touched. Docker itself refuses to remove an image a container uses, a second guard.
# A failure never fails the update: it prints what was removed, if anything, and returns 0.
PRUNE_IMAGE_NAMES=${VYRE_PRUNE_IMAGE_NAMES:-'agent-computer|workspace|space-browser|vyre-browser'}
prune_images() {
  command -v docker >/dev/null 2>&1 || return 0
  docker info >/dev/null 2>&1 || return 0
  keep_ids=""
  for ref in $( { cat "$DIR"/releases/*/images.lock "$DIR/compose.env"; } 2>/dev/null | sed -n 's/^VYRE_[A-Z_]*IMAGE=//p' | sort -u ); do
    id=$(docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null) && keep_ids="$keep_ids $id"
  done
  listing=$(docker images --no-trunc --format '{{.ID}} {{.Repository}}@{{.Digest}}' 2>/dev/null) || return 0
  removed=0
  for id in $(printf '%s\n' "$listing" | awk '{print $1}' | sort -u); do
    case " $keep_ids " in *" $id "*) continue ;; esac
    [ -z "$(docker ps -a -q --filter "ancestor=$id" 2>/dev/null)" ] || continue
    refs=$(printf '%s\n' "$listing" | awk -v i="$id" '$1 == i { print $2 }')
    # an image someone tagged by hand (a name with no digest) is theirs, even when the same image also carries a digest name
    ! printf '%s\n' "$refs" | grep -Eq '^[^<].*@<none>$' || continue
    ours=0
    case "$(docker image inspect -f '{{index .Config.Labels "ai.vyre.image"}}' "$id" 2>/dev/null)" in ""|"<no value>") ;; *) ours=1 ;; esac
    case "$(docker image inspect -f '{{join .Config.Cmd " "}}' "$id" 2>/dev/null)" in *"/opt/agentd/main.ts"*) [ "$refs" != "${refs#*<none>@<none>}" ] && ours=1 ;; esac
    for r in $refs; do
      case "$r" in *"<none>"*) continue ;; esac
      printf '%s\n' "$r" | grep -Eq "(^|/)($PRUNE_IMAGE_NAMES)@sha256:" && ours=1
    done
    [ "$ours" = 1 ] || continue
    gone=1; did=0
    for r in $refs; do
      case "$r" in *"<none>@<none>"*) if docker rmi "$id" >/dev/null 2>&1; then did=1; else gone=0; fi ;; *"<none>"*) ;; *@sha256:*) if docker rmi "$r" >/dev/null 2>&1; then did=1; else gone=0; fi ;; esac
    done
    if [ "$gone" = 1 ] && [ "$did" = 1 ]; then removed=$((removed + 1)); fi
  done
  [ "$removed" = 0 ] || say "  Removed $removed old agent computer, workspace or browser $( [ "$removed" = 1 ] && printf image || printf images )."
  return 0
}

lock_update_operation() {
  operation_lock_path="$DIR/state/update.lock"
  mkdir -p "$DIR/state"
  # A lock whose owner has died (pid file names a process that is gone) is reclaimed; one with no pid file is left for a person to look at.
  if [ -d "$operation_lock_path" ] && [ -f "$operation_lock_path/pid" ]; then
    owner=$(cat "$operation_lock_path/pid" 2>/dev/null || true)
    case "$owner" in ""|*[!0-9]*) ;; *) kill -0 "$owner" 2>/dev/null || { rm -f "$operation_lock_path/pid"; rmdir "$operation_lock_path" 2>/dev/null || true; } ;; esac
  fi
  # A failed contender owns nothing: EXIT cleanup must leave the active lock alone.
  if mkdir "$operation_lock_path" 2>/dev/null; then LOCKDIR=$operation_lock_path; printf '%s\n' "$$" >"$operation_lock_path/pid"
  elif [ -d "$operation_lock_path" ]; then die "another update or rollback is running (or died: check $operation_lock_path)." 75
  else die "could not create the update lock; check the install directory permissions." 1
  fi
  [ ! -f "$(PENDING_FILE)" ] || recover_pending
}

parse_update_args() {
  check_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check_only=1 ;;
      --yes|-y) YES=1 ;;
      --dry-run) DRY=1 ;;
      --stopped-backup) STOPPED_BACKUP=1 ;;
      --channel) shift; [ $# -gt 0 ] || die "--channel needs a value" 2; CHANNEL=$1 ;;
      --version) shift; [ $# -gt 0 ] || die "--version needs a value" 2; [ -n "$1" ] || die "--version needs a value" 2; WANT=$1 ;;
      --sha256) shift; [ $# -gt 0 ] || die "--sha256 needs a value" 2; [ -n "$1" ] || die "--sha256 needs a value" 2; WANT_SHA256=$1 ;;
      --feed-base) shift; [ $# -gt 0 ] || die "--feed-base needs a value" 2; UPDATE_URL=$1 ;;
      *) die "update takes --check, --yes, --dry-run, --stopped-backup, --channel, --version, --sha256 or --feed-base" 2 ;;
    esac
    shift
  done
  case "$CHANNEL" in stable|beta|nightly) ;; *) die "--channel is stable, beta or nightly" 2 ;; esac
  [ -z "$WANT" ] || ver_cmp "$WANT" "$WANT" >/dev/null 2>&1 || die "--version must name a release version" 2
  if [ -n "$WANT_SHA256" ]; then
    case "$WANT_SHA256" in *[!0-9a-f]*) die "--sha256 must be 64 hexadecimal characters" 2 ;; esac
    [ "${#WANT_SHA256}" = 64 ] || die "--sha256 must be 64 hexadecimal characters" 2
  fi
  case "$UPDATE_URL" in http://*|https://*) ;; *) die "--feed-base must be an HTTP or HTTPS address" 2 ;; esac
}

# An update has two halves. The first (any release from this one on) reads the signed manifest, checks and unpacks the new release, and holds the update lock. The rest (pulls, backup,
# stop, switch, health check, roll back) is carried out by the NEW release's own script, so a fix to the updater applies to the update that delivers it: before, an update was always run
# whole by the old release's script, and rc.24 died on an image pull that rc.25 had made optional. The trust is the same as before: it is the signed, verified release that runs after
# the switch anyway. VYRE_UPDATE_CONTINUE=1 marks the second half: it never hands off again and never delegates, so nothing can loop. The second half runs as a child, not by exec: the
# first half keeps the lock (the child checks that the lock names its parent) and, should the child stop without finishing, puts the old version back and starts it.
# A new release whose script cannot carry out an update (none in the field yet; a script with no VYRE_UPDATE_CONTINUE) gets the old behaviour: this script does it all.
update_delegate() {
  new="$DIR/releases/$REL_VERSION/bin/vyre-server"
  [ "${VYRE_UPDATE_CONTINUE:-0}" != 1 ] || return 1
  [ -f "$new" ] && grep -q 'VYRE_UPDATE_CONTINUE' "$new" 2>/dev/null || return 1
  # a signal to this half waits for the child (which has its own traps) and is then handled below, so it can never undo what the child finished
  trap 'UPDATE_SIGNALLED=1' INT TERM HUP
  VYRE_UPDATE_CONTINUE=1 VYRE_UPDATE_FROM=$from VYRE_UPDATE_TO=$REL_VERSION VYRE_UPDATE_STARTED=$started VYRE_UPDATE_LOCK_PID=$$ VYRE_HANDOFF=1 VYRE_DIR=$DIR \
    sh "$new" update "$@" && urc=0 || urc=$?
  trap - INT TERM HUP
  case "$urc" in
    0|4|5) ;;
    *)
      # the second half stopped before it finished: the old version back (an update cut off mid-switch left update.pending), and the server started
      if [ -f "$(PENDING_FILE)" ]; then recover_pending; else dc up -d --remove-orphans >/dev/null 2>&1 || true; resume_strays; fi
      if [ "$(cur_version)" = "$from" ] && [ -f "$DIR/state/update.started" ]; then printf 'vyre-server: the new release'"'"'s updater stopped before it finished (exit %s); the server was started again on %s.\n' "$urc" "$from" >&2; fi ;;
  esac
  rm -f "$DIR/state/update.started"
  exit "$urc"
}

cmd_update() {
  if [ "${VYRE_UPDATE_CONTINUE:-0}" = 1 ]; then update_continue "$@"; return; fi
  parse_update_args "$@"
  TMP=$(mktemp -d "${TMPDIR:-/tmp}/vyre-update.XXXXXX")
  lock_update_operation
  started=$(date +%s)
  from=$(cur_version)
  fetch_release
  c=$(ver_cmp "$REL_VERSION" "$from") || die "the running version ($from) or the offered one ($REL_VERSION) is not a version."
  if [ "$c" -le 0 ]; then say "Vyre Server $from is the newest on the $CHANNEL channel."; return 0; fi
  say "Vyre Server $REL_VERSION is available (running $from)."
  [ "$check_only" = 0 ] || return 10
  if [ "$DRY" = 1 ]; then say "Would install $REL_VERSION from the $CHANNEL channel; no images, backups or running services were changed."; return 0; fi
  unpack_release
  [ -n "$(sed -n 's/^VYRE_IMAGE=//p' "$DIR/releases/$REL_VERSION/images.lock")" ] || die "the release names no server image; nothing was changed."
  update_delegate "$@" || true
  update_apply
}

# update_continue ARGS...: the second half, in the new release's script. What the first half learned comes in the environment; the flags are parsed again from the same arguments.
update_continue() {
  parse_update_args "$@"
  lp=$(cat "$DIR/state/update.lock/pid" 2>/dev/null || true)
  [ -n "$lp" ] && [ "$lp" = "${VYRE_UPDATE_LOCK_PID:-}" ] && kill -0 "$lp" 2>/dev/null || die "this is the second half of an update, but the update lock is not held by the first half that started it; nothing was changed."
  from=${VYRE_UPDATE_FROM:-}; REL_VERSION=${VYRE_UPDATE_TO:-}; started=${VYRE_UPDATE_STARTED:-$(date +%s)}
  [ -n "$from" ] && [ -f "$DIR/releases/$REL_VERSION/.complete" ] || die "the second half of the update was not told which release to install; nothing was changed."
  update_apply
}

# update_apply: pulls, backup, stop, switch, health check, roll back. Run by the new release's script (update_continue) or, for a new release that cannot, by the old one.
update_apply() {
  for k in VYRE_IMAGE VYRE_AGENT_IMAGE VYRE_BROWSER_IMAGE VYRE_WORKSPACE_IMAGE VYRE_SANDBOX_IMAGE; do
    ref=$(sed -n "s/^$k=//p" "$DIR/releases/$REL_VERSION/images.lock" | head -n 1)
    [ -n "$ref" ] || continue
    case "$ref" in *@sha256:*) ;; *) die "the release names $k without a digest; nothing was changed." ;; esac
    # the old per-agent desktop image is Intel only and nothing new uses it: a computer it cannot be pulled on (Apple silicon) updates without it (the installers do the same)
    if [ "$k" = VYRE_AGENT_IMAGE ]; then docker pull -q "$ref" >/dev/null 2>&1 || say "  (skipped: the old agent desktop image is not available for this computer, and nothing new needs it)"; continue; fi
    docker pull -q "$ref" >/dev/null || die "could not pull $ref; nothing was changed."
  done
  trap update_interrupted INT TERM HUP
  : >"$DIR/state/update.started" 2>/dev/null || true
  if [ "$STOPPED_BACKUP" = 1 ]; then
    # the old order, for a person who wants one copy that is consistent across every database file: the server is down for the whole backup
    backup_data "pre-$REL_VERSION"
    say "  Backed up to $BACKUP_FILE"
    backup_note
  else
    # The backup is the long part (every database is copied and the folder is compressed). It is taken while the server keeps running, each database as one consistent snapshot, and
    # only then is the server stopped, so the Space is down for the switch and the restart alone. Writes made after a database was copied are not in the backup file.
    backup_data "pre-$REL_VERSION" live
    say "  Backed up to $BACKUP_FILE while the server kept running."
    backup_note
    dc stop >/dev/null || true
    stop_strays
  fi
  prev_link=$(readlink "$DIR/current")
  [ -n "$prev_link" ] || { dc up -d --remove-orphans >/dev/null 2>&1 || true; die "the install has no current release to go back to; nothing was changed."; }
  printf '%s\n' "$prev_link" >"$DIR/state/update.pending"
  printf '%s\n' "$prev_link" >"$DIR/previous"
  set_current "$REL_VERSION"
  ln -sfn "$DIR/vyre.env" "$DIR/releases/$REL_VERSION/vyre.env"
  refresh_bin
  ensure_userns
  reason=""
  if ! sync_image; then reason="the new version's image could not be set"
  elif ! up_stack; then reason="the new version did not start"
  elif ! wait_healthy; then reason="the new version did not pass its health check"
  fi
  secs=$(( $(date +%s) - started ))
  resume_strays
  rm -f "$DIR/state/update.started"
  if [ -z "$reason" ]; then
    # Only a healthy install changes the daily updater's selected feed.
    printf '%s\n' "$CHANNEL" >"$DIR/channel"
    printf '%s\n' "$UPDATE_URL" >"$DIR/update-url"
    rm -f "$DIR/state/update.pending"
    record_update "$from" "$REL_VERSION" ok "$secs" ""
    prune_releases
    prune_images || true
    say "Updated to $REL_VERSION in $secs s."
    return 0
  fi
  # Roll back: the previous release's code and image. Data written by the new version stays; the backup is kept. What the new version said last is kept first, so the reason is never lost.
  said=$(server_said "$DIR/state/update-$REL_VERSION-failed.log")
  say "  $reason; going back to $from."
  [ -z "$said" ] || say "  The new version said: $said"
  set_current "${prev_link#releases/}"
  sync_image || true
  rm -f "$DIR/state/update.pending"
  refresh_bin
  up_stack || true
  if wait_healthy; then record_update "$from" "$REL_VERSION" rolled_back "$secs" "$reason"; die "the update to $REL_VERSION failed ($reason) and the server is back on $from. Backup: $BACKUP_FILE" 4; fi
  record_update "$from" "$REL_VERSION" failed "$secs" "$reason"
  said_old=$(server_said "$DIR/state/update-$REL_VERSION-rollback.log")
  printf 'vyre-server: the update to %s failed (%s) and the server did not come back healthy on %s either.\n' "$REL_VERSION" "$reason" "$from" >&2
  [ -z "$said_old" ] || printf '  The server says: %s\n' "$said_old" >&2
  bad=$(damaged_db_in "$DIR/state/update-$REL_VERSION-rollback.log" "$DIR/state/update-$REL_VERSION-failed.log")
  [ -z "$bad" ] || printf '  The database %s is damaged (the server does not repair it).\n' "$DATA_DIR/space/$bad" >&2
  printf '  To put back the data from just before this update, run:\n    vyre-server restore %s --yes\n' "$BACKUP_FILE" >&2
  if [ "$STOPPED_BACKUP" = 1 ]; then printf '  That backup was taken with the server stopped, so nothing written before the update is lost. The data now in place is kept beside it.\n' >&2
  else printf '  It loses what the Space wrote after that backup, which was taken moments before the server stopped for the switch. The data now in place is kept beside it.\n' >&2; fi
  printf '  The server'"'"'s last log lines are in %s.\n' "$DIR/state/update-$REL_VERSION-rollback.log" >&2
  exit 5
}

# server_said FILE: keeps vyred's last log lines in FILE and prints the one line that says why it stopped (the last line naming an error, else the last line), without the compose prefix.
server_said() {
  dc logs --no-color --tail 80 vyred >"$1" 2>&1 || true
  sed 's/^[^|]*| //' "$1" | awk 'NF { last = $0 } /[Ee]rror|malformed|damaged|cannot|could not|did not|failed|vyred: / { hit = $0 } END { if (hit != "") print hit; else print last }' | cut -c1-400
}
# damaged_db_in FILE...: the database a log names as damaged (vyred says "vyred: space/<name>.db is damaged"), or nothing.
damaged_db_in() {
  cat "$@" 2>/dev/null | sed -n 's/.*vyred: \([^ ]*\.db\) is damaged.*/\1/p' | tail -n 1
}

cmd_rollback() {
  lock_update_operation
  [ -f "$DIR/previous" ] || die "there is no earlier release to go back to."
  prev=$(sed -n 's|^releases/||p' "$DIR/previous" | head -n 1)
  [ -n "$prev" ] && [ -f "$DIR/releases/$prev/.complete" ] || die "the earlier release ($prev) is no longer on disk."
  from=$(cur_version)
  [ "$from" != "$prev" ] || die "already on $prev."
  say "Switching from $from to $prev. Data written by $from stays; only the code goes back."
  printf 'releases/%s\n' "$from" >"$DIR/previous"
  set_current "$prev"
  sync_image || die "the image of $prev could not be set; read $DIR/releases/$prev/images.lock."
  refresh_bin
  ensure_userns
  up_stack || die "the server did not start on $prev. Read: vyre-server logs."
  wait_healthy || die "the server did not become healthy on $prev. Read: vyre-server logs."
  record_update "$from" "$prev" rolled_back 0 "manual rollback"
  say "Running $prev."
}

main() {
  trap cleanup EXIT
  [ $# -gt 0 ] || { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
  cmd=$1; shift
  hand_off "$cmd" "$@"
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    status) cmd_status ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_stop; cmd_start ;;
    logs) cmd_logs "$@" ;;
    claim-link) cmd_claim_link ;;
    update) cmd_update "$@" ;;
    fix-userns) ensure_userns; say "Done." ;;
    rollback) cmd_rollback ;;
    backup) cmd_backup ;;
    restore) cmd_restore "$@" ;;
    version|--version) say "$(cur_version)" ;;
    -h|--help|help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command $cmd (try: vyre-server help)" 2 ;;
  esac
}

if [ "${VYRE_SOURCE_ONLY:-0}" != 1 ]; then main "$@"; fi

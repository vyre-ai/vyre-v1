{
  "name": "vyre-v1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "lib",
    "contracts",
    "manifest",
    "kernel",
    "host",
    "sync",
    "agent",
    "sandbox",
    "modules/*",
    "client",
    "ui",
    "apps/*",
    "relay/*",
    "kits/*",
    "connectors/*",
    "testkit",
    "scripts/shots/app"
  ],
  "scripts": {
    "test": "node scripts/test-run.mjs --all",
    "test:affected": "node scripts/test-run.mjs --affected",
    "select": "node scripts/ci-select.mjs",
    "gen": "node -e \"console.log('gen: placeholder until lane L11 lands scripts/gen.mjs')\"",
    "check": "node scripts/test-run.mjs --affected",
    "perf": "node -e \"console.log('perf: placeholder until lane L11 lands scripts/perf.mjs')\"",
    "golden": "node -e \"console.log('golden: placeholder until lane L11 lands scripts/golden.mjs')\"",
    "release": "node -e \"console.log('release: placeholder until lane L11 lands scripts/release.mjs')\"",
    "shots": "node scripts/shots/shots.mjs",
    "theme-flash": "node scripts/shots/theme-flash.mjs"
  },
  "dependencies": {
    "y-protocols": "1.0.6",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@testing-library/react-native": "14.1.0",
    "babel-preset-expo": "~58.0.20",
    "expo": "58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0",
    "playwright-core": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "test-renderer": "^1.3.1",
    "tsx": "4.23.15",
    "wabt": "1.0.39"
  }
}

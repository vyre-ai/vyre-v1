{
  "key": "estate-planning",
  "title": "Estate planning",
  "version": "1.0.0",
  "channel": "stable",
  "description": "Estate-planning structure in one click: client plans with a sealed tax ID, a six-stage Journey ending in signing, a questionnaire and a drafting assistant.",
  "items": [
    {
      "key": "rt.client_plan",
      "content": "structure",
      "type": "record_type",
      "title": "Client plan",
      "recordType": "client_plan"
    },
    {
      "key": "ui.layout.client_plan",
      "content": "ui",
      "type": "layout",
      "title": "Client plan page",
      "apply": {
        "cap": "schema.layout.set",
        "input": {
          "type": "client_plan",
          "sections": [
            {
              "key": "client",
              "title": "Client",
              "fields": [
                "client",
                "stage",
                "trust_name"
              ]
            },
            {
              "key": "documents",
              "title": "Documents",
              "fields": [
                "tax_id",
                "signed"
              ]
            }
          ]
        }
      }
    },
    {
      "key": "journey.estate_plan",
      "content": "structure",
      "type": "journey",
      "title": "Estate plan",
      "apply": {
        "cap": "journeys.create",
        "input": {
          "name": "Estate plan",
          "subjectType": "client_plan",
          "stages": [
            {
              "key": "intake",
              "title": "Intake",
              "order": 0,
              "exit": {
                "requireTasks": true
              },
              "tasks": [
                {
                  "key": "questionnaire",
                  "title": "Collect the questionnaire",
                  "kind": "answer",
                  "assigned": {
                    "kind": "role",
                    "id": "admin"
                  },
                  "required": true
                },
                {
                  "key": "assets",
                  "title": "Collect the asset list",
                  "kind": "work",
                  "assigned": {
                    "kind": "role",
                    "id": "admin"
                  },
                  "required": true
                }
              ],
              "automations": []
            },
            {
              "key": "drafting",
              "title": "Drafting",
              "order": 1,
              "exit": {
                "requireTasks": true
              },
              "tasks": [
                {
                  "key": "draft_documents",
                  "title": "Draft the trust, will and powers of attorney",
                  "kind": "work",
                  "assigned": {
                    "kind": "role",
                    "id": "admin"
                  },
                  "required": true
                }
              ],
              "automations": []
            },
            {
              "key": "review",
              "title": "Review",
              "order": 2,
              "exit": {
                "requireTasks": true
              },
              "tasks": [
                {
                  "key": "attorney_review",
                  "title": "Attorney review of the drafts",
                  "kind": "review",
                  "assigned": {
                    "kind": "role",
                    "id": "admin"
                  },
                  "required": true
                }
              ],
              "automations": [],
              "timeLimit": {
                "hours": 120,
                "escalateTo": {
                  "kind": "role",
                  "id": "admin"
                }
              }
            },
            {
              "key": "signing",
              "title": "Signing",
              "order": 3,
              "exit": {
                "requireTasks": true
              },
              "tasks": [
                {
                  "key": "sign_documents",
                  "title": "Send the documents for signature",
                  "kind": "signature",
                  "assigned": {
                    "kind": "role",
                    "id": "admin"
                  },
                  "required": true
                }
              ],
              "automations": []
            },
            {
              "key": "funding",
              "title": "Funding",
              "order": 4,
              "exit": {
                "requireTasks": true
              },
              "tasks": [
                {
                  "key": "fund_trust",
                  "title": "Retitle assets into the trust",
                  "kind": "work",
                  "assigned": {
                    "kind": "role",
                    "id": "admin"
                  },
                  "required": true
                }
              ],
              "automations": []
            },
            {
              "key": "complete",
              "title": "Complete",
              "order": 5,
              "exit": {
                "requireTasks": false
              },
              "tasks": [],
              "automations": [],
              "final": true
            }
          ],
          "startRule": {
            "event": "record.created",
            "enabled": true
          },
          "idempotencyKey": "kit.estate-planning.journey.estate_plan"
        }
      }
    },
    {
      "key": "form.questionnaire",
      "content": "structure",
      "type": "form",
      "title": "Estate planning questionnaire",
      "apply": {
        "cap": "forms.create",
        "input": {
          "name": "Estate planning questionnaire",
          "recordType": "client_plan",
          "kind": "one_use",
          "idempotencyKey": "kit.estate-planning.form.questionnaire"
        }
      }
    },
    {
      "key": "auto.questionnaire_in",
      "content": "steps",
      "type": "automation",
      "title": "Questionnaire in: summarise it and ask for a review",
      "apply": {
        "cap": "automations.create",
        "input": {
          "name": "Questionnaire received",
          "description": "When a client sends the questionnaire, writes a one-page summary and asks an admin to review it.",
          "idempotencyKey": "kit.estate-planning.auto.questionnaire_in",
          "definition": {
            "triggers": [
              {
                "key": "form_submit"
              }
            ],
            "nodes": [
              {
                "id": "summarise",
                "key": "ai",
                "title": "Summarise the questionnaire",
                "input": {
                  "prompt": "Write a one-page summary of the client's answers: family, assets, wishes and anything unusual."
                },
                "next": [
                  "review"
                ]
              },
              {
                "id": "review",
                "key": "create_task",
                "title": "Review the summary",
                "input": {
                  "kind": "review",
                  "title": "Review the questionnaire summary",
                  "recordId": "{{trigger.recordId}}",
                  "assigned": {
                    "kind": "role",
                    "id": "admin"
                  }
                }
              }
            ]
          }
        }
      },
      "tools": [
        "records.update",
        "tasks.create"
      ]
    },
    {
      "key": "runbook.estate_check",
      "content": "steps",
      "type": "runbook",
      "title": "Check estate plans in flight",
      "tools": [
        "files.resolve",
        "files.folder.create",
        "files.create"
      ],
      "apply": {
        "cap": "file.put",
        "input": {
          "path": "Projects/Runbooks/Estate planning/check-estate-plans.md",
          "content": "# Check estate plans in flight\n\nRun this before the weekly review. It shows the Estate plan Journey and the record types behind it.\n\n```sh\nvyre journeys list\n```\n\nA plan that sits in Review longer than its time limit lands in the owner's Needs you; open it from there.\n\n```sh\nvyre schema describe\n```\n"
        }
      }
    },
    {
      "key": "agent.drafting_assistant",
      "content": "tools",
      "type": "agent",
      "title": "Drafting assistant",
      "tools": [
        "records.query",
        "records.update",
        "files.read",
        "esign.send"
      ],
      "apply": {
        "cap": "agents.create",
        "input": {
          "name": "Drafting assistant",
          "role": "Prepares estate documents from the client plan and sends them for signature once an attorney approves.",
          "tools": {
            "allowed": [
              "records.query",
              "records.update",
              "files.read",
              "esign.send"
            ],
            "denied": []
          },
          "idempotencyKey": "kit.estate-planning.agent.drafting_assistant"
        }
      }
    }
  ],
  "tests": [
    {
      "name": "the client plan exists after install, with its page layout",
      "kind": "space",
      "expect": {
        "events": [
          {
            "name": "schema.changed"
          }
        ],
        "views": [
          {
            "cap": "schema.types.list",
            "rows": 1,
            "contains": {
              "key": "client_plan"
            }
          }
        ]
      }
    },
    {
      "name": "the estate Journey, the questionnaire Automation and the Drafting assistant are created",
      "kind": "space",
      "expect": {
        "events": [
          {
            "name": "journey.created"
          },
          {
            "name": "automation.created"
          },
          {
            "name": "agent.created"
          }
        ]
      }
    }
  ]
}

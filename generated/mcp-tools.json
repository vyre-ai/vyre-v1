      "cap": "connectors.define",
      "deferred": false,
      "description": "Say what a draft connector is in one call: the hosts it may reach, how it signs in (a secret slot the connection fills from a Vault handle), and its actions. A GET is a read; anything else must be marked write. Replaces the draft; nothing goes live until publish.",
      "effects": "write",
      "inputSchema": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "headers": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ],
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "output": {
                  "type": "string"
                },
                "query": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "url": {
                  "type": "string"
                },
                "write": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "url"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "auth": {
            "properties": {
              "header": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              },
              "secret": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "none",
                  "api_key",
                  "bearer"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "domains": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "key": {
            "examples": [
              "hubspot"
            ],
            "type": "string"
          },
          "secrets": {
            "items": {
              "properties": {
                "description": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "domains",
          "auth",
          "actions"
        ],
        "type": "object"
      },
      "name": "connectors_define",
      "planMode": "blocked",
      "toolset": "automations",
      "v": 1
    },

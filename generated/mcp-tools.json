    {
      "blocks": [],
      "cap": "access.exceptions.set",
      "deferred": false,
      "description": "Give a person or a group a permission exception: Allowed or Not allowed on a permission or a whole area, against their role. A person beats a group beats the role; the Owner is never restricted; you give only what you hold",
      "effects": "write",
      "inputSchema": {
        "properties": {
          "area": {
            "type": "string"
          },
          "effect": {
            "enum": [
              "allow",
              "deny",
              "own",
              "ask"
            ],
            "type": "string"
          },
          "idempotencyKey": {
            "examples": [
              "idem_1"
            ],
            "minLength": 1,
            "type": "string"
          },
          "perms": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "subject": {
            "properties": {
              "id": {
                "examples": [
                  "usr_a1b2c3"
                ],
                "pattern": "^(usr|grp)_[a-z0-9_]+$",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "person",
                  "group"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          },
          "until": {
            "description": "Milliseconds since the Unix epoch",
            "examples": [
              1760000000000
            ],
            "minimum": 0,
            "type": "integer"
          },
          "why": {
            "maxLength": 300,
            "type": "string"
          }
        },
        "required": [
          "subject",
          "effect",
          "idempotencyKey"
        ],
        "type": "object"
      },
      "name": "access_exceptions_set",
      "planMode": "blocked",
      "toolset": "engineer",
      "v": 1
    },

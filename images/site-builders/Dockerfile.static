# Site builder: static (buildpacks-lite, spec 2.20, ARCH 7.6). Serves a folder of ready files with Caddy on port 3000.
# STATIC_DIR is the folder holding index.html (the context root by default).
FROM caddy:2-alpine
ARG STATIC_DIR=.
COPY ${STATIC_DIR} /srv
# a single-page app answers its own routes: a path that is no file gets index.html
RUN printf ':3000 {\n\troot * /srv\n\tencode gzip\n\ttry_files {path} {path}/index.html /index.html\n\tfile_server\n}\n' > /etc/caddy/Caddyfile
EXPOSE 3000
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

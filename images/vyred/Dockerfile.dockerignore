# Used by BuildKit for images/vyred/Dockerfile only: keeps the context small and keeps secrets and local state out of the image.
.git
**/node_modules
**/.env
**/.env.*
**/*.pem
**/*.key
**/dist
**/.expo
**/.turbo
**/coverage
.github
docs
# except docs/frozen: the MCP and engine modules read agent-tools.md at start, and the gateway cannot start without it (rc.14 server installs crash-looped)
!docs/frozen
!docs/frozen/**
spikes
# the app's web export (the release runs scripts/app-export.mjs before the bake): the Space serves it at its own address and join links (host/src/routes/app-files.ts)
!apps/app/dist
!apps/app/dist/**
# and still nothing secret from it
apps/app/dist/**/.env
apps/app/dist/**/.env.*
apps/app/dist/**/*.pem
apps/app/dist/**/*.key

#!/usr/bin/env node
// browserd's control program (modules/computers/sbrowser): `ctl <action> '<json>'` asks the running browserd over its unix socket and prints the answer.
// An answer is one JSON object on stdout and exit 0. A refusal is {"code","message"} on the last line of stderr and a non-zero exit (code 1: browserd refused; 3: browserd is not up yet, the request was
// never sent, so asking again is safe; 4: browserd stopped after the request was sent, so it may have been done: never ask again by itself).
import net from "node:net";

const SOCKET = process.env.VYRE_BROWSERD_SOCKET || "/tmp/browserd.sock";
const [action, arg] = process.argv.slice(2);

function die(code, message, exit) {
  process.stderr.write(JSON.stringify({ code, message }) + "\n");
  process.exit(exit);
}

if (!action) die("bad_input", "ctl needs an action", 2);
let args = {};
if (arg !== undefined && arg !== "") {
  try { args = JSON.parse(arg); } catch { die("bad_input", "the argument is not JSON", 2); }
}

const sock = net.connect(SOCKET);
let buf = "";
let done = false;
let sent = false;
sock.setEncoding("utf8");
sock.on("connect", () => { sent = true; sock.write(JSON.stringify({ action, args }) + "\n"); });
sock.on("data", (d) => {
  buf += d;
  const at = buf.indexOf("\n");
  if (at < 0 || done) return;
  done = true;
  let r;
  try { r = JSON.parse(buf.slice(0, at)); } catch { die("unavailable", "browserd answered with something that is not JSON", 1); }
  if (r && r.ok === true) {
    process.stdout.write(JSON.stringify(r.result === undefined ? {} : r.result) + "\n", () => process.exit(0));
  } else {
    die((r && r.code) || "unavailable", (r && r.message) || "browserd refused", 1);
  }
});
sock.on("error", (e) => { if (!done) (sent ? die("unavailable", "browserd stopped while it worked on the request: " + e.message, 4) : die("unavailable", "browserd is not up yet: " + e.message, 3)); });
sock.on("close", () => { if (!done) (sent ? die("unavailable", "browserd stopped while it worked on the request", 4) : die("unavailable", "browserd is not up yet", 3)); });
